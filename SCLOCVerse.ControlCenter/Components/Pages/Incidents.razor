@page "/incidents"
@inject IControlCenterRepository Repository
@using SCLOCVerse.ControlCenter.Services
@rendermode InteractiveServer

<PageTitle>Incidents — SCLOC Control Center</PageTitle>

@if (_error != null)
{
    <div class="alert alert-danger">@_error</div>
}
else if (_loading)
{
    <div class="spinner-border text-primary" role="status"></div>
}
else if (_detail != null)
{
    @* ── Incident Details ── *@
    <div class="d-flex align-items-center mb-3">
        <h1 class="me-3">@_detail.IncidentId</h1>
        <span class="badge @(_detail.HighestSeverity == "Critical" ? "bg-danger" : "bg-warning text-dark") fs-6">
            @_detail.HighestSeverity
        </span>
        <span class="badge bg-secondary fs-6 ms-1">@_detail.Status</span>
    </div>

    <button class="btn btn-outline-secondary btn-sm mb-3" @onclick="BackToList">← Back to list</button>

    @if (!string.IsNullOrEmpty(_knowledgeHint))
    {
        <div class="alert alert-info alert-dismissible mb-3">
            @_knowledgeHint
            <button type="button" class="btn-close" aria-label="Close" @onclick="() => _knowledgeHint = null"></button>
        </div>
    }

    <div class="row">
        @* Left: properties *@
        <div class="col-md-5">
            <h5>Properties</h5>
            <table class="table table-sm">
                <tbody>
                    <tr><th>Fingerprint</th><td><code class="text-wrap">@_detail.FingerprintKey</code></td></tr>
                    <tr><th>Release</th><td>@_detail.Release</td></tr>
                    <tr><th>Component</th><td>@_detail.Component</td></tr>
                    <tr><th>Operation</th><td>@_detail.Operation</td></tr>
                    <tr><th>Signal</th><td><code>@_detail.Signal</code></td></tr>
                    <tr><th>Event Count</th><td>@_detail.EventCount</td></tr>
                    <tr><th>Affected Users</th><td>@_detail.AffectedUsers</td></tr>
                    <tr><th>Affected Installs</th><td>@_detail.AffectedInstalls</td></tr>
                    <tr><th>Peak Failure</th><td>@FormatPct(_detail.PeakFailurePct)</td></tr>
                    <tr><th>Opened</th><td>@_detail.OpenedAt.ToString("yyyy-MM-dd HH:mm")</td></tr>
                    <tr><th>Last Event</th><td>@_detail.LastEventAt.ToString("yyyy-MM-dd HH:mm")</td></tr>
                    @if (_detail.ClosedAt.HasValue)
                    {
                        <tr><th>Closed</th><td>@_detail.ClosedAt.Value.ToString("yyyy-MM-dd HH:mm")</td></tr>
                    }
                </tbody>
            </table>
        </div>

        @* Right: root event + trace + evidence *@
        <div class="col-md-7">
            @if (_detail.KnownSolution != null)
            {
                <div class="card mb-3 border-success">
                    <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
                        <strong>Known Solution</strong>
                        <div class="d-flex gap-2 align-items-center">
                            <span class="badge bg-light text-dark">@_detail.KnownSolution.Status — @_detail.KnownSolution.Confidence</span>
                            <span class="text-white-50 small">Updated @_detail.KnownSolution.UpdatedAt.ToString("yyyy-MM-dd HH:mm")</span>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h6 class="card-title mb-0">@_detail.KnownSolution.Title</h6>
                            <div class="btn-group btn-group-sm" role="group">
                                <button class="btn btn-sm btn-outline-secondary" @onclick="OpenEditKnowledgeModal" disabled="@_working">Edit</button>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="OpenHistoryModal" disabled="@_working">History</button>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="OpenReferenceModal" disabled="@_working">+ Reference</button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="OpenArchiveModal" disabled="@_working">Archive</button>
                            </div>
                        </div>

                        <dl class="row mb-1 small">
                            <dt class="col-sm-3">Cause</dt>
                            <dd class="col-sm-9">@_detail.KnownSolution.KnownCause</dd>

                            @if (!string.IsNullOrWhiteSpace(_detail.KnownSolution.Symptoms))
                            {
                                <dt class="col-sm-3">Symptoms</dt>
                                <dd class="col-sm-9">@_detail.KnownSolution.Symptoms</dd>
                            }

                            @if (!string.IsNullOrWhiteSpace(_detail.KnownSolution.Workaround))
                            {
                                <dt class="col-sm-3">Workaround</dt>
                                <dd class="col-sm-9">@_detail.KnownSolution.Workaround</dd>
                            }

                            @if (!string.IsNullOrWhiteSpace(_detail.KnownSolution.PermanentFix))
                            {
                                <dt class="col-sm-3">Fix</dt>
                                <dd class="col-sm-9">@_detail.KnownSolution.PermanentFix</dd>
                            }

                            @if (!string.IsNullOrWhiteSpace(_detail.KnownSolution.FixedVersion))
                            {
                                <dt class="col-sm-3">Fixed In</dt>
                                <dd class="col-sm-9"><code>@_detail.KnownSolution.FixedVersion</code></dd>
                            }

                            @if (!string.IsNullOrWhiteSpace(_detail.KnownSolution.AffectedVersions))
                            {
                                <dt class="col-sm-3">Affected</dt>
                                <dd class="col-sm-9"><code>@_detail.KnownSolution.AffectedVersions</code></dd>
                            }

                            @if (_detail.KnownSolution.References.Count > 0)
                            {
                                <dt class="col-sm-3">References</dt>
                                <dd class="col-sm-9">
                                    @foreach (var r in _detail.KnownSolution.References)
                                    {
                                        <div class="d-flex align-items-center gap-2">
                                            @if (!string.IsNullOrWhiteSpace(r.Url))
                                            {
                                                <a href="@r.Url" target="_blank">@(r.Label ?? r.Url)</a>
                                            }
                                            else
                                            {
                                                <span>@(r.Label ?? r.Type)</span>
                                            }
                                            <button type="button" class="btn btn-link btn-sm p-0 text-danger" title="Remove" @onclick="() => RemoveReference(r.ReferenceId)" disabled="@_working">×</button>
                                        </div>
                                    }
                                </dd>
                            }
                        </dl>
                    </div>
                </div>
            }
            else if (!string.IsNullOrEmpty(_detail.DraftKnowledgeStatus))
            {
                <div class="card mb-3 border-info">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <span class="text-info">📝 Knowledge @_detail.DraftKnowledgeStatus exists (ID @_detail.DraftKnowledgeId). It will appear as Known Solution after verification.</span>
                    </div>
                </div>
            }
            else
            {
                <div class="card mb-3 border-secondary">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <span class="text-muted">🔍 No knowledge found.</span>
                        @if (_canCreateKnowledge)
                        {
                            <button class="btn btn-sm btn-success" @onclick="OpenKnowledgeModal" disabled="@_working">
                                Save as Knowledge
                            </button>
                        }
                        else if (_detail.Status == "Active" || _detail.Status == "Confirmed" || _detail.Status == "Investigating")
                        {
                            <span class="text-muted small">Available after Mitigated / Resolved / Closed</span>
                        }
                        else if (string.IsNullOrEmpty(_detail.Owner))
                        {
                            <span class="text-muted small">Assign owner first</span>
                        }
                    </div>
                </div>
            }

            @if (_detail.RootEvent != null)
            {
                <h5>Root Event (first failure)</h5>
                <div class="card bg-light mb-3">
                    <div class="card-body">
                        <strong>@_detail.RootEvent.Component / @_detail.RootEvent.Operation / @_detail.RootEvent.Outcome</strong><br/>
                        <span class="text-muted">Signal:</span> <code>@_detail.RootEvent.Signal</code><br/>
                        @if (_detail.RootEvent.ErrorMessage != null)
                        {
                            <span class="text-muted">Message:</span> @_detail.RootEvent.ErrorMessage<br/>
                        }
                        @if (_detail.RootEvent.Source != null)
                        {
                            <span class="text-muted">Source:</span> @_detail.RootEvent.Source<br/>
                        }
                        @if (_detail.RootEvent.HttpStatus != null)
                        {
                            <span class="text-muted">HTTP:</span> @_detail.RootEvent.HttpStatus<br/>
                        }
                        @if (_detail.RootEvent.Hresult != null)
                        {
                            <span class="text-muted">HRESULT:</span> <code>@_detail.RootEvent.Hresult</code><br/>
                        }
                        @if (_detail.RootEvent.SupabaseCode != null)
                        {
                            <span class="text-muted">Supabase:</span> <code>@_detail.RootEvent.SupabaseCode</code><br/>
                        }
                        @if (_detail.RootEvent.DurationMs != null)
                        {
                            <span class="text-muted">Duration:</span> @(($"{_detail.RootEvent.DurationMs}ms"))<br/>
                        }
                    </div>
                </div>
            }

            @if (_detail.Trace.Count > 0)
            {
                <div class="d-flex align-items-center mb-2">
                    <h5 class="me-3">Trace (user journey)</h5>
                    <NavLink href="/traces" class="btn btn-outline-primary btn-sm">Open in Trace Explorer →</NavLink>
                </div>
                <table class="table table-sm">
                    <thead>
                        <tr><th>#</th><th>Component</th><th>Operation</th><th>Outcome</th><th>Signal</th><th>Time</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var step in _detail.Trace)
                        {
                            <tr class="@(step.Outcome == "Failed" ? "table-danger" : "")">
                                <td>@step.Step</td>
                                <td>@step.Component</td>
                                <td>@step.Operation</td>
                                <td>@step.Outcome</td>
                                <td><code>@step.Signal</code></td>
                                <td>@step.OccurredAt.ToString("HH:mm:ss")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            @if (_detail.RelatedEvents.Count > 0)
            {
                <h5>Related Events (latest @_detail.RelatedEvents.Count failures)</h5>
                <table class="table table-sm">
                    <thead>
                        <tr><th>Time</th><th>Component</th><th>Signal</th><th>Message</th><th>Duration</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var ev in _detail.RelatedEvents)
                        {
                            <tr>
                                <td>@ev.OccurredAt.ToString("MM-dd HH:mm")</td>
                                <td>@ev.Component</td>
                                <td><code>@ev.Signal</code></td>
                                <td class="text-truncate" style="max-width: 200px;">@ev.ErrorMessage</td>
                                <td>@(ev.DurationMs != null ? $"{ev.DurationMs}ms" : "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            @* ── Workflow Actions (Phase 5) ── *@
            <h5 class="mt-3">Workflow</h5>
            <div class="d-flex gap-2 flex-wrap mb-3">
                @if (_detail.Status != "Closed")
                {
                    var nextStates = GetNextStates(_detail.Status);
                    @foreach (var s in nextStates)
                    {
                        <button class="btn btn-sm @(s == "Closed" ? "btn-outline-secondary" : s == "Resolved" ? "btn-success" : "btn-primary")"
                                @onclick="() => DoTransition(s)" disabled="@_working">
                            @s
                        </button>
                    }
                }
                else
                {
                    <span class="text-muted">Інцидент закрито.</span>
                }
            </div>

            @* Owner *@
            <div class="mb-3">
                <label class="form-label small">Owner</label>
                <div class="d-flex gap-2">
                    <input class="form-control form-control-sm" style="max-width: 200px;" @bind="_ownerInput" placeholder="username" />
                    <button class="btn btn-sm btn-outline-secondary" @onclick="DoAssignOwner" disabled="@_working">Assign</button>
                </div>
                @if (!string.IsNullOrEmpty(_detail.Owner))
                {
                    <span class="badge bg-info ms-1">@_detail.Owner</span>
                }
            </div>

            @* Timeline (Стаття 22 — immutable journal) *@
            @if (_detail.Timeline.Count > 0)
            {
                <h5>Timeline</h5>
                <div class="border-start ps-3 ms-2">
                    @foreach (var t in _detail.Timeline)
                    {
                        <div class="mb-2">
                            <span class="text-muted small">@t.ChangedAt.ToString("MM-dd HH:mm")</span><br/>
                            <strong>@t.FromStatus</strong> → <strong>@t.ToStatus</strong>
                            <span class="text-muted">by @t.ChangedBy</span>
                            @if (!string.IsNullOrEmpty(t.Note))
                            {
                                <br/><span class="text-muted small">@t.Note</span>
                            }
                        </div>
                    }
                </div>
            }

            @* Notes *@
            <h5 class="mt-3">Notes</h5>
            <div class="mb-2">
                <textarea class="form-control form-control-sm" rows="2" @bind="_noteInput" placeholder="Додати нотатку…"></textarea>
                <button class="btn btn-sm btn-outline-primary mt-1" @onclick="DoAddNote" disabled="@_working">Add Note</button>
            </div>
            @if (_detail.Notes.Count > 0)
            {
                @foreach (var n in _detail.Notes)
                {
                    <div class="bg-light rounded p-2 mb-1">
                        <small class="text-muted">@n.CreatedBy · @n.CreatedAt.ToString("MM-dd HH:mm")</small><br/>
                        @n.Content
                    </div>
                }
            }
            else
            {
                <p class="text-muted small">Немає нотаток.</p>
            }
        </div>
    </div>

    @* ── Save as Knowledge Modal ── *@
    @if (_showKnowledgeModal)
    {
        <div class="modal fade show" tabindex="-1" style="display: block;" aria-modal="true" role="dialog">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Save as Knowledge — @_detail.IncidentId</h5>
                        <button type="button" class="btn-close" aria-label="Close" @onclick="CloseKnowledgeModal"></button>
                    </div>
                    <div class="modal-body">
                        <p class="small text-muted">
                            Fingerprint: <code>@_detail.FingerprintKey</code>
                        </p>

                        <div class="mb-3">
                            <label class="form-label">Title</label>
                            <input type="text" class="form-control" @bind="_knowledgeInput.Title" placeholder="Short title" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Known Cause</label>
                            <textarea class="form-control" rows="3" @bind="_knowledgeInput.KnownCause" placeholder="Root cause"></textarea>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Workaround (optional)</label>
                            <textarea class="form-control" rows="2" @bind="_knowledgeInput.Workaround" placeholder="Temporary workaround for users"></textarea>
                        </div>

                        @if (!string.IsNullOrEmpty(_knowledgeHint))
                        {
                            <div class="alert alert-info small">@_knowledgeHint</div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseKnowledgeModal" disabled="@_working">Cancel</button>
                        <button type="button" class="btn btn-success" @onclick="DoCreateKnowledge" disabled="@_working">
                            @if (_working)
                            {
                                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            }
                            Save as Draft
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal-backdrop fade show"></div>
    }

    @* ── Edit Knowledge Modal ── *@
    @if (_showEditKnowledgeModal)
    {
        <div class="modal fade show" tabindex="-1" style="display: block;" aria-modal="true" role="dialog">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Edit Knowledge — @_detail.KnownSolution?.Title</h5>
                        <button type="button" class="btn-close" aria-label="Close" @onclick="CloseEditKnowledgeModal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Title</label>
                            <input type="text" class="form-control" @bind="_knowledgeEditInput.Title" placeholder="Short title" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Known Cause</label>
                            <textarea class="form-control" rows="3" @bind="_knowledgeEditInput.KnownCause" placeholder="Root cause"></textarea>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Symptoms</label>
                            <textarea class="form-control" rows="3" @bind="_knowledgeEditInput.Symptoms" placeholder="What users see"></textarea>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Workaround (optional)</label>
                            <textarea class="form-control" rows="2" @bind="_knowledgeEditInput.Workaround" placeholder="Temporary workaround"></textarea>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Permanent Fix (optional)</label>
                            <textarea class="form-control" rows="2" @bind="_knowledgeEditInput.PermanentFix" placeholder="What was fixed"></textarea>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label">Affected Versions (comma-separated)</label>
                                <input type="text" class="form-control" @bind="_knowledgeEditInput.AffectedVersions" placeholder="1.0.0,1.0.1" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Fixed Version</label>
                                <input type="text" class="form-control" @bind="_knowledgeEditInput.FixedVersion" placeholder="1.0.2" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Change Reason</label>
                            <input type="text" class="form-control" @bind="_knowledgeEditInput.ChangeReason" placeholder="Why are you editing this?" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseEditKnowledgeModal" disabled="@_working">Cancel</button>
                        <button type="button" class="btn btn-primary" @onclick="DoUpdateKnowledge" disabled="@_working">
                            @if (_working)
                            {
                                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            }
                            Save Changes
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal-backdrop fade show"></div>
    }

    @* ── Knowledge History Modal ── *@
    @if (_showHistoryModal)
    {
        <div class="modal fade show" tabindex="-1" style="display: block;" aria-modal="true" role="dialog">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Knowledge History — @_detail.KnownSolution?.Title</h5>
                        <button type="button" class="btn-close" aria-label="Close" @onclick="CloseHistoryModal"></button>
                    </div>
                    <div class="modal-body">
                        @if (_knowledgeHistory.Count == 0)
                        {
                            <p class="text-muted">No history available.</p>
                        }
                        else
                        {
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Version</th>
                                        <th>When</th>
                                        <th>By</th>
                                        <th>Reason</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var h in _knowledgeHistory)
                                    {
                                        <tr>
                                            <td><span class="badge bg-secondary">@h.Version</span></td>
                                            <td>@h.ChangedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                            <td>@h.ChangedBy <span class="text-muted small">(@h.DbUser)</span></td>
                                            <td>@h.ChangeReason</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseHistoryModal">Close</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal-backdrop fade show"></div>
    }

    @* ── Add Reference Modal ── *@
    @if (_showReferenceModal)
    {
        <div class="modal fade show" tabindex="-1" style="display: block;" aria-modal="true" role="dialog">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Add Reference — @_detail.KnownSolution?.Title</h5>
                        <button type="button" class="btn-close" aria-label="Close" @onclick="CloseReferenceModal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Type</label>
                            <select class="form-select" @bind="_knowledgeReferenceInput.Type">
                                <option value="GitHubIssue">GitHub Issue</option>
                                <option value="GitCommit">Git Commit</option>
                                <option value="Documentation">Documentation</option>
                                <option value="External">External</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">URL</label>
                            <input type="url" class="form-control" @bind="_knowledgeReferenceInput.Url" placeholder="https://..." />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Label</label>
                            <input type="text" class="form-control" @bind="_knowledgeReferenceInput.Label" placeholder="Issue #42" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseReferenceModal" disabled="@_working">Cancel</button>
                        <button type="button" class="btn btn-primary" @onclick="DoAddReference" disabled="@_working">
                            @if (_working)
                            {
                                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            }
                            Add Reference
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal-backdrop fade show"></div>
    }

    @* ── Archive Knowledge Modal ── *@
    @if (_showArchiveModal)
    {
        <div class="modal fade show" tabindex="-1" style="display: block;" aria-modal="true" role="dialog">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Archive Knowledge</h5>
                        <button type="button" class="btn-close" aria-label="Close" @onclick="CloseArchiveModal"></button>
                    </div>
                    <div class="modal-body">
                        <p class="text-muted small">Archive is a final state. The Knowledge will no longer appear as Known Solution for matching incidents.</p>
                        <div class="mb-3">
                            <label class="form-label">Archive Reason</label>
                            <input type="text" class="form-control" @bind="_archiveReasonInput" placeholder="Why is this knowledge being archived?" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseArchiveModal" disabled="@_working">Cancel</button>
                        <button type="button" class="btn btn-danger" @onclick="DoArchiveKnowledge" disabled="@_working">
                            @if (_working)
                            {
                                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            }
                            Archive
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal-backdrop fade show"></div>
    }
}
else
{
    @* ── Incident List ── *@
    <h1>Incidents</h1>

    <div class="btn-group mb-3" role="group">
        <button class="btn btn-sm @(_filter == "Active" ? "btn-primary" : "btn-outline-primary")" @onclick='() => LoadIncidents("Active")'>Active</button>
        <button class="btn btn-sm @(_filter == "Closed" ? "btn-primary" : "btn-outline-primary")" @onclick='() => LoadIncidents("Closed")'>Closed</button>
        <button class="btn btn-sm @(_filter == null ? "btn-primary" : "btn-outline-primary")" @onclick='() => LoadIncidents(null)'>All</button>
    </div>

    @if (_incidents.Count == 0)
    {
        <p class="text-success fw-semibold">✅ Немає інцидентів у цій категорії.</p>
    }
    else
    {
        <table class="table table-sm table-hover">
            <thead>
                <tr>
                    <th>INC-ID</th>
                    <th>Severity</th>
                    <th>Component</th>
                    <th>Signal</th>
                    <th>Events</th>
                    <th>Affected</th>
                    <th>Opened</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var inc in _incidents)
                {
                    <tr class="@(inc.HighestSeverity == "Critical" ? "table-danger" : "table-warning")"
                        style="cursor: pointer"
                        @onclick="() => OpenDetail(inc.IncidentId)">
                        <td><strong>@inc.IncidentId</strong></td>
                        <td>
                            <span class="badge @(inc.HighestSeverity == "Critical" ? "bg-danger" : "bg-warning text-dark")">
                                @inc.HighestSeverity
                            </span>
                        </td>
                        <td>@inc.Component</td>
                        <td><code>@inc.Signal</code></td>
                        <td>@inc.EventCount</td>
                        <td>@inc.AffectedInstalls</td>
                        <td>@inc.OpenedAt.ToString("MM-dd HH:mm")</td>
                        <td>@inc.Status</td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    private List<ActiveIncident> _incidents = new();
    private IncidentDetail? _detail;
    private string? _filter = "Active";
    private string? _error;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        try { await LoadIncidents("Active"); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    private async Task LoadIncidents(string? filter)
    {
        _filter = filter;
        _detail = null;
        _loading = true;
        StateHasChanged();
        try
        {
            _incidents = await Repository.GetIncidentsAsync(filter);
            _error = null;
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    private async Task OpenDetail(string incidentId)
    {
        _loading = true;
        StateHasChanged();
        try
        {
            _detail = await Repository.GetIncidentDetailAsync(incidentId);
            if (_detail == null)
                _error = $"Інцидент {incidentId} не знайдено.";
            else
                _canCreateKnowledge = await Repository.CanCreateKnowledgeForIncidentAsync(_detail.Id);
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    private void BackToList()
    {
        _detail = null;
    }

    private static string FormatPct(decimal? pct) => pct.HasValue ? $"{pct.Value:F1}%" : "—";

    private string _ownerInput = "";
    private string _noteInput = "";
    private bool _working;
    private bool _canCreateKnowledge;
    private bool _showKnowledgeModal;
    private bool _showEditKnowledgeModal;
    private bool _showHistoryModal;
    private bool _showReferenceModal;
    private bool _showArchiveModal;
    private KnowledgeDraftInput _knowledgeInput = new();
    private KnowledgeEditInput _knowledgeEditInput = new();
    private KnowledgeReferenceInput _knowledgeReferenceInput = new();
    private string? _knowledgeHint;
    private List<KnowledgeHistoryEntry> _knowledgeHistory = new();
    private string _archiveReasonInput = "";

    private static readonly Dictionary<string, string[]> StateFlow = new()
    {
        ["Active"] = new[] { "Confirmed", "Investigating", "Mitigated", "Resolved", "Closed" },
        ["Confirmed"] = new[] { "Investigating", "Mitigated", "Resolved", "Closed" },
        ["Investigating"] = new[] { "Mitigated", "Resolved", "Closed" },
        ["Mitigated"] = new[] { "Resolved", "Closed" },
        ["Resolved"] = new[] { "Closed" },
        ["Closed"] = Array.Empty<string>(),
    };

    private static string[] GetNextStates(string current) =>
        StateFlow.GetValueOrDefault(current, Array.Empty<string>());

    private async Task DoTransition(string toStatus)
    {
        if (_detail == null) return;
        _working = true; StateHasChanged();
        try
        {
            await Repository.TransitionIncidentAsync(_detail.Id, toStatus, "admin", null);
            _detail = await Repository.GetIncidentDetailAsync(_detail.IncidentId);
            _canCreateKnowledge = await Repository.CanCreateKnowledgeForIncidentAsync(_detail!.Id);
            _error = null;
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _working = false; }
    }

    private async Task DoAssignOwner()
    {
        if (_detail == null || string.IsNullOrWhiteSpace(_ownerInput)) return;
        _working = true; StateHasChanged();
        try
        {
            await Repository.AssignOwnerAsync(_detail.Id, _ownerInput.Trim());
            _detail = await Repository.GetIncidentDetailAsync(_detail.IncidentId);
            _canCreateKnowledge = await Repository.CanCreateKnowledgeForIncidentAsync(_detail!.Id);
            _ownerInput = "";
            _error = null;
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _working = false; }
    }

    private async Task DoAddNote()
    {
        if (_detail == null || string.IsNullOrWhiteSpace(_noteInput)) return;
        _working = true; StateHasChanged();
        try
        {
            await Repository.AddIncidentNoteAsync(_detail.Id, _noteInput.Trim(), "admin");
            _detail = await Repository.GetIncidentDetailAsync(_detail.IncidentId);
            _error = null;
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _working = false; }
    }

    private void OpenKnowledgeModal()
    {
        _knowledgeInput = new KnowledgeDraftInput
        {
            Title = $"{_detail?.Component} / {_detail?.Signal}",
            KnownCause = "",
            Workaround = ""
        };
        _knowledgeHint = "Knowledge will be saved as Draft (Low confidence). Verification happens later through release health.";
        _showKnowledgeModal = true;
    }

    private void CloseKnowledgeModal()
    {
        _showKnowledgeModal = false;
        _knowledgeInput = new KnowledgeDraftInput();
        _knowledgeHint = null;
    }

    private async Task DoCreateKnowledge()
    {
        if (_detail == null) return;
        if (string.IsNullOrWhiteSpace(_knowledgeInput.Title) || string.IsNullOrWhiteSpace(_knowledgeInput.KnownCause))
        {
            _error = "Title and Known Cause are required.";
            return;
        }

        _working = true; StateHasChanged();
        try
        {
            var sanitized = new KnowledgeDraftInput
            {
                Title = PiiSanitizer.Sanitize(_knowledgeInput.Title) ?? "",
                KnownCause = PiiSanitizer.Sanitize(_knowledgeInput.KnownCause) ?? "",
                Workaround = PiiSanitizer.Sanitize(_knowledgeInput.Workaround)
            };

            var result = await Repository.CreateKnowledgeFromIncidentAsync(_detail.Id, sanitized, "admin");
            _showKnowledgeModal = false;
            _knowledgeInput = new KnowledgeDraftInput();
            _knowledgeHint = null;

            if (result.CreatedNew)
            {
                _error = null;
                _knowledgeHint = $"✅ Knowledge Draft created (ID {result.KnowledgeId}).";
            }
            else
            {
                _error = null;
                _knowledgeHint = $"ℹ Knowledge already exists for this fingerprint (ID {result.KnowledgeId}).";
            }

            _detail = await Repository.GetIncidentDetailAsync(_detail.IncidentId);
            _canCreateKnowledge = await Repository.CanCreateKnowledgeForIncidentAsync(_detail!.Id);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _working = false;
        }
    }

    // ── Knowledge Lifecycle modals ──

    private async Task OpenEditKnowledgeModal()
    {
        if (_detail?.KnownSolution == null) return;
        var version = await Repository.GetKnowledgeCurrentVersionAsync(_detail.KnownSolution.KnowledgeId);
        _knowledgeEditInput = new KnowledgeEditInput
        {
            ExpectedVersion = version,
            Title = _detail.KnownSolution.Title,
            Symptoms = _detail.KnownSolution.Symptoms,
            KnownCause = _detail.KnownSolution.KnownCause,
            Workaround = _detail.KnownSolution.Workaround,
            PermanentFix = _detail.KnownSolution.PermanentFix,
            AffectedVersions = _detail.KnownSolution.AffectedVersions,
            FixedVersion = _detail.KnownSolution.FixedVersion,
            ChangeReason = ""
        };
        _showEditKnowledgeModal = true;
    }

    private void CloseEditKnowledgeModal()
    {
        _showEditKnowledgeModal = false;
        _knowledgeEditInput = new KnowledgeEditInput();
    }

    private async Task DoUpdateKnowledge()
    {
        if (_detail?.KnownSolution == null) return;
        if (string.IsNullOrWhiteSpace(_knowledgeEditInput.Title) || string.IsNullOrWhiteSpace(_knowledgeEditInput.KnownCause))
        {
            _error = "Title and Known Cause are required.";
            return;
        }
        if (string.IsNullOrWhiteSpace(_knowledgeEditInput.ChangeReason))
        {
            _error = "Change reason is required.";
            return;
        }

        _working = true; StateHasChanged();
        try
        {
            var sanitized = new KnowledgeEditInput
            {
                ExpectedVersion = _knowledgeEditInput.ExpectedVersion,
                Title = PiiSanitizer.Sanitize(_knowledgeEditInput.Title) ?? "",
                Symptoms = PiiSanitizer.Sanitize(_knowledgeEditInput.Symptoms),
                KnownCause = PiiSanitizer.Sanitize(_knowledgeEditInput.KnownCause) ?? "",
                Workaround = PiiSanitizer.Sanitize(_knowledgeEditInput.Workaround),
                PermanentFix = PiiSanitizer.Sanitize(_knowledgeEditInput.PermanentFix),
                AffectedVersions = _knowledgeEditInput.AffectedVersions,
                FixedVersion = _knowledgeEditInput.FixedVersion,
                ChangeReason = _knowledgeEditInput.ChangeReason
            };

            await Repository.UpdateKnowledgeAsync(_detail.KnownSolution.KnowledgeId, sanitized, "admin");
            _showEditKnowledgeModal = false;
            _knowledgeEditInput = new KnowledgeEditInput();
            _error = null;
            _knowledgeHint = "✅ Knowledge updated.";
            _detail = await Repository.GetIncidentDetailAsync(_detail.IncidentId);
            _canCreateKnowledge = await Repository.CanCreateKnowledgeForIncidentAsync(_detail!.Id);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _working = false;
        }
    }

    private async Task OpenHistoryModal()
    {
        if (_detail?.KnownSolution == null) return;
        _knowledgeHistory = await Repository.GetKnowledgeHistoryAsync(_detail.KnownSolution.KnowledgeId);
        _showHistoryModal = true;
    }

    private void CloseHistoryModal() => _showHistoryModal = false;

    private void OpenReferenceModal()
    {
        _knowledgeReferenceInput = new KnowledgeReferenceInput { Type = "GitHubIssue", Url = "", Label = "" };
        _showReferenceModal = true;
    }

    private void CloseReferenceModal()
    {
        _showReferenceModal = false;
        _knowledgeReferenceInput = new KnowledgeReferenceInput();
    }

    private async Task DoAddReference()
    {
        if (_detail?.KnownSolution == null) return;
        if (string.IsNullOrWhiteSpace(_knowledgeReferenceInput.Url) || string.IsNullOrWhiteSpace(_knowledgeReferenceInput.Label))
        {
            _error = "URL and Label are required.";
            return;
        }

        _working = true; StateHasChanged();
        try
        {
            var sanitized = new KnowledgeReferenceInput
            {
                Type = _knowledgeReferenceInput.Type,
                Url = PiiSanitizer.Sanitize(_knowledgeReferenceInput.Url) ?? "",
                Label = PiiSanitizer.Sanitize(_knowledgeReferenceInput.Label) ?? ""
            };

            await Repository.AddKnowledgeReferenceAsync(_detail.KnownSolution.KnowledgeId, sanitized, "admin");
            _showReferenceModal = false;
            _knowledgeReferenceInput = new KnowledgeReferenceInput();
            _error = null;
            _knowledgeHint = "✅ Reference added.";
            _detail = await Repository.GetIncidentDetailAsync(_detail.IncidentId);
            _canCreateKnowledge = await Repository.CanCreateKnowledgeForIncidentAsync(_detail!.Id);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _working = false;
        }
    }

    private async Task RemoveReference(long referenceId)
    {
        if (_detail?.KnownSolution == null) return;
        _working = true; StateHasChanged();
        try
        {
            await Repository.RemoveKnowledgeReferenceAsync(referenceId, "admin");
            _error = null;
            _knowledgeHint = "✅ Reference removed.";
            _detail = await Repository.GetIncidentDetailAsync(_detail.IncidentId);
            _canCreateKnowledge = await Repository.CanCreateKnowledgeForIncidentAsync(_detail!.Id);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _working = false;
        }
    }

    private void OpenArchiveModal()
    {
        _archiveReasonInput = "";
        _showArchiveModal = true;
    }

    private void CloseArchiveModal()
    {
        _showArchiveModal = false;
        _archiveReasonInput = "";
    }

    private async Task DoArchiveKnowledge()
    {
        if (_detail?.KnownSolution == null) return;
        if (string.IsNullOrWhiteSpace(_archiveReasonInput))
        {
            _error = "Archive reason is required.";
            return;
        }

        _working = true; StateHasChanged();
        try
        {
            await Repository.ArchiveKnowledgeAsync(_detail.KnownSolution.KnowledgeId, _archiveReasonInput.Trim(), "admin");
            _showArchiveModal = false;
            _archiveReasonInput = "";
            _error = null;
            _knowledgeHint = "✅ Knowledge archived.";
            _detail = await Repository.GetIncidentDetailAsync(_detail.IncidentId);
            _canCreateKnowledge = await Repository.CanCreateKnowledgeForIncidentAsync(_detail!.Id);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _working = false;
        }
    }
}
