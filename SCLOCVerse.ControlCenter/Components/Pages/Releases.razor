@page "/releases"
@inject IControlCenterRepository Repository
@rendermode InteractiveServer

<PageTitle>Release Health — SCLOC Control Center</PageTitle>

<h1>Release Health</h1>
<p class="text-muted">Чи можна безпечно випускати наступну версію?</p>

@if (_error != null)
{
    <div class="alert alert-danger">@_error</div>
}
else if (_loading)
{
    <div class="spinner-border text-primary" role="status"></div>
}
else
{
    @* ── Knowledge Ready (Coverage) ── *@
    @if (_coverage != null)
    {
        var pct = decimal.ToDouble(_coverage.CoveragePct);
        var readyColor = pct >= 80 ? "text-success" : pct >= 50 ? "text-warning" : "text-danger";
        var borderColor = pct >= 80 ? "border-success" : pct >= 50 ? "border-warning" : "border-danger";
        <div class="card mb-4 @borderColor">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>📚 Knowledge Ready</strong>
                <span class="badge bg-light text-dark">@_coverage.CoveredFingerprints / @_coverage.TotalFingerprints</span>
            </div>
            <div class="card-body text-center">
                <div class="row align-items-center">
                    <div class="col-md-4">
                        <h3 class="@readyColor mb-0">@pct.ToString("F1")%</h3>
                        <small class="text-muted">Coverage</small>
                    </div>
                    <div class="col-md-4">
                        <h3 class="text-success mb-0">@_coverage.CoveredFingerprints</h3>
                        <small class="text-muted">Covered</small>
                    </div>
                    <div class="col-md-4">
                        <h3 class="@(pct >= 80 ? "text-success" : "text-warning") mb-0">@_coverage.UncoveredFingerprints</h3>
                        <small class="text-muted">Unknown Fingerprints</small>
                    </div>
                </div>
                @if (_coverage.UncoveredFingerprints > 0 && pct < 80)
                {
                    <div class="alert alert-warning mt-3 mb-0 py-2 small">
                        ⚠ База знань покриває лише @pct.ToString("F0")% проблем. Документуйте топ-проблеми перед релізом.
                    </div>
                }
            </div>
        </div>
    }

    @if (_releases.Count == 0)
    {
        <p class="text-muted">Немає даних за останні 7 днів.</p>
    }
    else
    {
    @foreach (var r in _releases)
    {
        <div class="card mb-3 @(r.Recommendation == "Rollback Recommended" ? "border-danger" : r.Recommendation == "Watch" ? "border-warning" : "border-success")">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div>
                    <strong class="fs-5">@r.AppVersion</strong>
                    @if (r.LastSeen.HasValue)
                    {
                        <span class="text-muted small ms-2">остання активність: @r.LastSeen.Value.ToString("MM-dd HH:mm")</span>
                    }
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="fs-4">@r.RecommendationIcon</span>
                    <span class="badge @(r.Recommendation == "Rollback Recommended" ? "bg-danger" : r.Recommendation == "Watch" ? "bg-warning text-dark" : "bg-success")">
                        @r.Recommendation
                    </span>
                </div>
            </div>
            <div class="card-body">
                <div class="row text-center mb-3">
                    <div class="col">
                        <h3 class="@(r.SuccessRate >= 95 ? "text-success" : r.SuccessRate >= 60 ? "text-warning" : "text-danger")">
                            @r.SuccessRate%
                        </h3>
                        <small class="text-muted">Success Rate</small>
                    </div>
                    <div class="col">
                        <h3>@r.Succeeded</h3>
                        <small class="text-muted">Succeeded</small>
                    </div>
                    <div class="col">
                        <h3 class="@(r.Failed > 0 ? "text-danger" : "")">@r.Failed</h3>
                        <small class="text-muted">Failed</small>
                    </div>
                    <div class="col">
                        <h3>@r.ActiveInstalls</h3>
                        <small class="text-muted">Installs</small>
                    </div>
                    <div class="col">
                        <h3>@r.ActiveUsers24h</h3>
                        <small class="text-muted">Users 24h</small>
                    </div>
                    <div class="col">
                        <h3 class="@(r.NewIncidents > 0 ? "text-warning" : "")">@r.NewIncidents</h3>
                        <small class="text-muted">Incidents</small>
                    </div>
                    <div class="col">
                        <h3 class="@(r.CriticalIncidents > 0 ? "text-danger" : "")">@r.CriticalIncidents</h3>
                        <small class="text-muted">Critical</small>
                    </div>
                </div>

                @if (r.TopFingerprints.Count > 0)
                {
                    <h6>Top Problem</h6>
                    @foreach (var fp in r.TopFingerprints)
                    {
                        <div class="d-flex justify-content-between align-items-center bg-light rounded p-2 mb-1">
                            <div>
                                <code>@fp.Fingerprint</code><br/>
                                <small class="text-muted">@fp.Component · @fp.Severity</small>
                            </div>
                            <span class="badge @(fp.Severity == "Critical" ? "bg-danger" : "bg-warning text-dark")">
                                @fp.EventCount events
                            </span>
                        </div>
                    }
                }
                else if (r.Failed == 0)
                {
                    <p class="text-success mb-0">✅ Немає проблемних fingerprint-ів.</p>
                }
            </div>
        </div>
    }
    }
}

@code {
    private List<ReleaseHealth> _releases = new();
    private bool _loading = true;
    private string? _error;
    private KnowledgeCoverage? _coverage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _releases = await Repository.GetReleaseHealthAsync();
            try
            {
                await Repository.RefreshKnowledgeCoverageAsync();
                _coverage = await Repository.GetKnowledgeCoverageAsync();
            }
            catch
            {
                // Coverage — best-effort
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }
}
