<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Settings Hub — Design Kit.
        Спільні стилі, що успадковуються всіма панелями налаштувань (P0 — дизайн-система).
        Див. docs/backlog/settings-hub-design-system.md.
    -->

    <!-- ============ ГРУПА (P3 — контраст і відокремлення) ============ -->

    <!-- x:Shared="False": кожна картка отримує ВЛАСНИЙ екземпляр ефекту.
         Без цього DropShadowEffect (невзаморожений Freezable) у Style.Setter,
         застосованому до кількох Border, кидає XamlParseException (DeferrableContent). -->
    <DropShadowEffect x:Key="HubCardShadow" x:Shared="False"
                      Color="#000000" BlurRadius="14" ShadowDepth="4" Direction="270" Opacity="0.55"/>

    <Style x:Key="HubGroupCard" TargetType="Border">
        <Setter Property="Background" Value="#102A3A"/>
        <Setter Property="BorderBrush" Value="#2F6D88"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Margin" Value="0,0,0,22"/>
        <Setter Property="Padding" Value="16,12"/>
        <!-- Підняття картки над затемненим фоном (атмосфера Control Center) -->
        <Setter Property="Effect" Value="{StaticResource HubCardShadow}"/>
    </Style>

    <Style x:Key="HubGroupLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#4AA3D8"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="2,0,0,10"/>
        <Setter Property="Opacity" Value="0.95"/>
    </Style>

    <!-- ============ ПОЛЯ РЯДКА (P4 — назва ліворуч, контрол праворуч) ============ -->

    <Style x:Key="HubFieldLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#EAF4FF"/>
        <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="HubFieldDesc" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#6F8CA8"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="HubHelpText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#8FAAB8"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Margin" Value="0,0,0,14"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- ============ KEYCAP — компактний індикатор клавіші (не кнопка) ============ -->
    <!-- Легкий, непомітний. Стани змінюють лише кольори/текст. Геометрія незмінна. -->

    <Style x:Key="HubKeycap" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="#B0CCE0"/>
        <Setter Property="Background" Value="#142B3D"/>
        <Setter Property="BorderBrush" Value="#1A3D54"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HubToggle" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="ToolTipService.Placement" Value="Top"/>
        <Setter Property="ToolTipService.InitialShowDelay" Value="200"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Track" Width="40" Height="22" CornerRadius="11"
                            Background="#1E4357" BorderBrush="#2A5A78" BorderThickness="1">
                        <Border x:Name="Knob" Width="16" Height="16" CornerRadius="8"
                                Background="#8FAAB8" HorizontalAlignment="Left" Margin="3,0,0,0"
                                VerticalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="1" Opacity="0.4"/>
                            </Border.Effect>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="#2478A9"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="#4AA3D8"/>
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Knob" Property="Background" Value="#C9E0F5"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsChecked" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Track" Property="Background" Value="#27455C"/>
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ RESET (P1 — нейтральне, НЕ небезпечне) ============ -->

    <!-- Маленький ↺ для поля (нейтральний, hover — блакитний, а не червоний) -->
    <Style x:Key="HubResetGlyph" TargetType="Button">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="#6F8CA8"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Content" Value="↺"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#162E42"/>
                            <Setter Property="Foreground" Value="#8DD0FF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Кнопка скидання категорії (↺ + текст, світло-сіра, НЕ конкурує з основними діями — P1) -->
    <Style x:Key="HubCategoryReset" TargetType="Button">
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="#6F8CA8"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="6,3">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#162E42"/>
                            <Setter Property="Foreground" Value="#9DBBD4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Kbd-бейдж для підказок гарячих клавіш -->
    <Style x:Key="HubKbdBadge" TargetType="Border">
        <Setter Property="Background" Value="#0A1D29"/>
        <Setter Property="BorderBrush" Value="#2A5A78"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="6,2"/>
    </Style>

    <!-- ============ SCROLLBAR (P0 — єдина мова, не стандартна) ============ -->

    <Style x:Key="HubScrollBarThumb" TargetType="Thumb">
        <Setter Property="Background" Value="#2A5A78"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="ThumbBd" Background="{TemplateBinding Background}" CornerRadius="3" Margin="1"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBd" Property="Background" Value="#4AA3D8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="10"/>
        <Setter Property="MinWidth" Value="10"/>
        <Setter Property="Margin" Value="2,0,0,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid>
                        <Border Background="#0A1828" CornerRadius="4" Opacity="0.6"/>
                        <Track Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Background="Transparent" Template="{x:Null}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource HubScrollBarThumb}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Background="Transparent" Template="{x:Null}"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ СТАТУСНІ БЕЙДЖІ (P0 — стан продукту видимий) ============ -->

    <Style x:Key="HubEnvBadgeFound" TargetType="Border">
        <Setter Property="Background" Value="#0E2A1C"/>
        <Setter Property="BorderBrush" Value="#2E6B45"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="Padding" Value="9,3"/>
    </Style>

    <Style x:Key="HubEnvBadge" TargetType="Border">
        <Setter Property="Background" Value="#0A1D29"/>
        <Setter Property="BorderBrush" Value="#1E4357"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="Padding" Value="9,3"/>
    </Style>

    <!-- ============ КОМАНДНА КНОПКА (первинна дія — об'ємна, градієнт + підняття) ============ -->

    <Style x:Key="HubActionButton" TargetType="Button">
        <Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="7" BorderBrush="#4AA3D8" BorderThickness="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#3492D8" Offset="0"/>
                                <GradientStop Color="#1F5F86" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="2" Direction="270" Opacity="0.4"/>
                        </Border.Effect>
                        <Grid>
                            <!-- Світла верхня грань (підняття) -->
                            <Border CornerRadius="6,6,0,0" Height="1" VerticalAlignment="Top" Background="#9ECAEE" Opacity="0.6" Margin="2,1,2,0"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#8DD0FF"/>
                            <Setter TargetName="Bd" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#46A6E8" Offset="0"/>
                                        <GradientStop Color="#267AA8" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#1F5F86" Offset="0"/>
                                        <GradientStop Color="#164A68" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Bd" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#000000" BlurRadius="3" ShadowDepth="1" Direction="270" Opacity="0.3"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Вторинна (приглушена) дія — ОБ'ЄМНА, світліша за картку (не disabled).
         "я не головна дія, але я точно кнопка". Див. P0/P1 Design Kit. -->
    <Style x:Key="HubSecondaryButton" TargetType="Button">
        <Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="#C9DEEF"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="7" BorderBrush="#5DA8D6" BorderThickness="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#1A3D52" Offset="0"/>
                                <GradientStop Color="#122C3C" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="0.25"/>
                        </Border.Effect>
                        <Grid>
                            <!-- Світла верхня грань (підняття) -->
                            <Border CornerRadius="6,6,0,0" Height="1" VerticalAlignment="Top" Background="#9EDBFF" Opacity="0.15" Margin="2,1,2,0"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <!-- Hover: border +20%, bg +10%, shadow +15%, highlight сильніший -->
                            <Setter Property="Foreground" Value="#EAF4FF"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#76BCE4"/>
                            <Setter TargetName="Bd" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#1F455C" Offset="0"/>
                                        <GradientStop Color="#163447" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Bd" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#000000" BlurRadius="9" ShadowDepth="3" Direction="270" Opacity="0.29"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Foreground" Value="#A7C6E7"/>
                            <Setter TargetName="Bd" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#122C3C" Offset="0"/>
                                        <GradientStop Color="#0E2230" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#4A93BF"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
