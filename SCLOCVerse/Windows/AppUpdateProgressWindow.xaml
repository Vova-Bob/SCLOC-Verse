<Window x:Class="SCLOCVerse.Windows.AppUpdateProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SCLOC-Verse — оновлення"
        Height="240"
        Width="480"
        MinWidth="420"
        MinHeight="220"
        MaxWidth="540"
        MaxHeight="280"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#0F2C3E"
        TextOptions.TextFormattingMode="Display"
        SnapsToDevicePixels="True"
        Closing="Window_Closing">

    <Window.Resources>
        <SolidColorBrush x:Key="WindowBackground" Color="#0F2C3E"/>
        <SolidColorBrush x:Key="ContentBackground" Color="#0A1D29"/>
        <SolidColorBrush x:Key="WindowBorder" Color="#6DB9F8"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#8DD0FF"/>
        <SolidColorBrush x:Key="PrimaryText" Color="White"/>
        <SolidColorBrush x:Key="SecondaryText" Color="#C7DDF0"/>
        <SolidColorBrush x:Key="ProgressFill" Color="#2196F3"/>
        <SolidColorBrush x:Key="ProgressTrack" Color="#1F3C4C"/>

        <Style x:Key="AppUpdateProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="14"/>
            <Setter Property="Background" Value="{StaticResource ProgressTrack}"/>
            <Setter Property="Foreground" Value="{StaticResource ProgressFill}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="TemplateRoot" SnapsToDevicePixels="True">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="7"
                                    Height="{TemplateBinding Height}"/>
                            <Border x:Name="PART_Track"
                                    Background="Transparent"
                                    CornerRadius="7"
                                    Height="{TemplateBinding Height}">
                                <Border x:Name="PART_Indicator"
                                        Background="{TemplateBinding Foreground}"
                                        CornerRadius="7"
                                        HorizontalAlignment="Left"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CancelButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1A3A4F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#6DB9F8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="14,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2A4A5F"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#102A3A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0">
                            <TextBlock x:Name="Icon"
                                       Text="&#xE8BB;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#FFFF4C4C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#FFB20000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource WindowBackground}"
            CornerRadius="10"
            BorderBrush="{StaticResource WindowBorder}"
            BorderThickness="1"
            Margin="8">
        <Border.Effect>
            <DropShadowEffect Color="Black"
                              BlurRadius="24"
                              ShadowDepth="0"
                              Opacity="0.45"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Кастомний заголовок -->
            <Border Grid.Row="0"
                    Background="{StaticResource WindowBackground}"
                    BorderBrush="#2F6D88"
                    BorderThickness="0,0,0,1"
                    CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid>
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Margin="12,0,0,0">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   Text="&#xE896;"
                                   Foreground="{StaticResource AccentBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>

                        <TextBlock Text="SCLOC-Verse"
                                   Foreground="{StaticResource PrimaryText}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   FontFamily="Arial"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button x:Name="WindowCloseButton"
                            Style="{StaticResource CloseButtonStyle}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Click="WindowCloseButton_Click"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="20,16,20,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="HeaderTextBlock"
                           Grid.Row="0"
                           Text="Встановлення оновлення"
                           Foreground="{StaticResource PrimaryText}"
                           FontSize="17"
                           FontWeight="Bold"
                           FontFamily="Arial"
                           Margin="0,0,0,12"/>

                <ProgressBar x:Name="ProgressBar"
                             Grid.Row="1"
                             Style="{StaticResource AppUpdateProgressBarStyle}"
                             Minimum="0"
                             Maximum="100"
                             Value="0"
                             Margin="0,0,0,10"/>

                <Grid Grid.Row="2" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock x:Name="PercentageTextBlock"
                                   FontFamily="Segoe UI"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"
                                   Margin="0,0,12,0"/>

                        <TextBlock x:Name="SizeTextBlock"
                                   FontFamily="Segoe UI"
                                   FontSize="13"
                                   Foreground="{StaticResource SecondaryText}"
                                   Margin="0,0,12,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock x:Name="SpeedTextBlock"
                                   FontFamily="Segoe UI"
                                   FontSize="13"
                                   Foreground="{StaticResource SecondaryText}"
                                   Margin="0,0,12,0"/>

                        <TextBlock x:Name="EtaTextBlock"
                                   FontFamily="Segoe UI"
                                   FontSize="13"
                                   Foreground="{StaticResource SecondaryText}"/>
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="StageTextBlock"
                           Grid.Row="3"
                           FontFamily="Segoe UI"
                           FontSize="13"
                           Foreground="{StaticResource PrimaryText}"
                           LineHeight="18"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"/>

                <Button x:Name="CancelButton"
                        Grid.Row="4"
                        Content="Скасувати"
                        Height="32"
                        Width="110"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource CancelButtonStyle}"
                        Click="CancelButton_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
