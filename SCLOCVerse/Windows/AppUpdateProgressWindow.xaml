<Window x:Class="SCLOCVerse.Windows.AppUpdateProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SCLOC-Verse — оновлення"
        Height="220"
        Width="480"
        MinWidth="420"
        MinHeight="200"
        MaxWidth="540"
        MaxHeight="260"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#0F2C3E"
        TextOptions.TextFormattingMode="Display"
        SnapsToDevicePixels="True"
        Closing="Window_Closing">

    <Window.Resources>
        <SolidColorBrush x:Key="WindowBackground" Color="#0F2C3E"/>
        <SolidColorBrush x:Key="WindowBorder" Color="#6DB9F8"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#8DD0FF"/>
        <SolidColorBrush x:Key="PrimaryText" Color="White"/>
        <SolidColorBrush x:Key="SecondaryText" Color="#C7DDF0"/>
        <SolidColorBrush x:Key="ProgressFill" Color="#2196F3"/>
        <SolidColorBrush x:Key="ProgressTrack" Color="#1F3C4C"/>

        <Style x:Key="AppUpdateProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="14"/>
            <Setter Property="Background" Value="{StaticResource ProgressTrack}"/>
            <Setter Property="Foreground" Value="{StaticResource ProgressFill}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="TemplateRoot" SnapsToDevicePixels="True">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="7"
                                    Height="{TemplateBinding Height}"/>
                            <Border x:Name="PART_Track"
                                    Background="Transparent"
                                    CornerRadius="7"
                                    Height="{TemplateBinding Height}">
                                <Border x:Name="PART_Indicator"
                                        Background="{TemplateBinding Foreground}"
                                        CornerRadius="7"
                                        HorizontalAlignment="Left"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource WindowBackground}"
            CornerRadius="10"
            BorderBrush="{StaticResource WindowBorder}"
            BorderThickness="1"
            Margin="8">
        <Border.Effect>
            <DropShadowEffect Color="Black"
                              BlurRadius="24"
                              ShadowDepth="0"
                              Opacity="0.45"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Кастомний заголовок (без кнопки закриття) -->
            <Border Grid.Row="0"
                    Background="{StaticResource WindowBackground}"
                    BorderBrush="#2F6D88"
                    BorderThickness="0,0,0,1"
                    CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="TitleBar_MouseDown">
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left"
                            Margin="12,0,0,0">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               FontSize="14"
                               Text="&#xE896;"
                               Foreground="{StaticResource AccentBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>

                    <TextBlock Text="SCLOC-Verse"
                               Foreground="{StaticResource PrimaryText}"
                               FontSize="14"
                               FontWeight="Bold"
                               FontFamily="Arial"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Контент: прогрес-бар + статус. Без кнопок. -->
            <Grid Grid.Row="1" Margin="20,16,20,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="HeaderTextBlock"
                           Grid.Row="0"
                           Text="Встановлення оновлення"
                           Foreground="{StaticResource PrimaryText}"
                           FontSize="17"
                           FontWeight="Bold"
                           FontFamily="Arial"
                           Margin="0,0,0,12"/>

                <ProgressBar x:Name="ProgressBar"
                             Grid.Row="1"
                             Style="{StaticResource AppUpdateProgressBarStyle}"
                             Minimum="0"
                             Maximum="100"
                             Value="0"
                             Margin="0,0,0,10"/>

                <Grid Grid.Row="2" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock x:Name="PercentageTextBlock"
                                   FontFamily="Segoe UI"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"
                                   Margin="0,0,12,0"/>

                        <TextBlock x:Name="SizeTextBlock"
                                   FontFamily="Segoe UI"
                                   FontSize="13"
                                   Foreground="{StaticResource SecondaryText}"
                                   Margin="0,0,12,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock x:Name="SpeedTextBlock"
                                   FontFamily="Segoe UI"
                                   FontSize="13"
                                   Foreground="{StaticResource SecondaryText}"
                                   Margin="0,0,12,0"/>

                        <TextBlock x:Name="EtaTextBlock"
                                   FontFamily="Segoe UI"
                                   FontSize="13"
                                   Foreground="{StaticResource SecondaryText}"/>
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="StageTextBlock"
                           Grid.Row="3"
                           FontFamily="Segoe UI"
                           FontSize="13"
                           Foreground="{StaticResource PrimaryText}"
                           LineHeight="18"
                           TextWrapping="Wrap"/>
            </Grid>
        </Grid>
    </Border>
</Window>
