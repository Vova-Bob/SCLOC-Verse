<Window x:Class="SCLOCVerse.Controls.SignatureScannerOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SignatureScanner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        ShowActivated="False">

    <!--
        Overlay "SC SCAN" — результат розпізнавання сигнатури Star Citizen.

        Структура (зверху вниз):
        ┌────────────────────────────┐
        │ SC SCAN                    │  ← Title (малий, приглушений)
        │                            │
        │ [Single candidate]:         │
        │   RICCITE                   │  ← Назва (великий, колір = рідкість)
        │   Рідкість: Epic            │
        │   ★★★★☆                     │
        │   ─────────────────────     │
        │   Кластер:    3 Rocks       │
        │   Сигнатура:  10155          │
        │   Сканування: ██████████ 100 │
        │                            │
        │ [Multi candidate (колізія)]:│
        │   12000                     │  ← Сигнатура (великий)
        │   ─────────────────────     │
        │   → ROC Mineable  Tier 3    │
        │   → FPS Mineable  Tier 4    │
        │   → Salvage       Tier 6    │
        │   ─────────────────────     │
        │   Сканування: ██████████ 100│
        └────────────────────────────┘

        Принципи:
        - Жодних змін у логіці розпізнавання.
        - Single-candidate блок Visible коли AllCandidates.Count <= 1.
        - Multi-candidate блок Visible при колізії (Count > 1).
        - Колір назви ресурсу встановлюється з code-behind через MiningRarityRegistry.
    -->
    <Border Background="#CC0A1D29"
            BorderBrush="#2A5A78"
            BorderThickness="1.5"
            CornerRadius="10"
            Padding="14,9">
        <StackPanel Orientation="Vertical">

            <!-- ── Шапка: заголовок сканера ── -->
            <TextBlock x:Name="TitleLabel"
                        Text="SC SCAN"
                        FontFamily="Segoe UI Semibold"
                        FontSize="9"
                        Foreground="#5F7E8A"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,3"/>

            <!-- ════════════════════════════════════════════════════════════════
                 БЛОК S: Scanning Radar (стан очікування)
                 Visible коли AllCandidates.Count == 0 AND ScanState ∈ {Idle, Scanning}.
                 Holographic SC Radar — sweep beam, концентричні кільця, пульсуючий центр,
                 мерехтливі точки. Fade-in/out через Opacity (200мс).
                 НЕ показує жодних технічних повідомлень.
            ════════════════════════════════════════════════════════════════ -->
            <StackPanel x:Name="ScanningPanel"
                        Orientation="Vertical"
                        HorizontalAlignment="Center"
                        Visibility="Visible"
                        Opacity="1">

                <!-- ── Canvas: круглий радар 110×110 ── -->
                <Grid Width="110" Height="110"
                      HorizontalAlignment="Center"
                      Margin="0,2,0,0">

                    <!-- Outer glow halo -->
                    <Ellipse Width="110" Height="110"
                             Stroke="#1A3DD6A8"
                             StrokeThickness="1"
                             Opacity="0.3"/>

                    <!-- Концентричні кільця -->
                    <Ellipse Width="90" Height="90"
                             Stroke="#3DD6A8"
                             StrokeThickness="0.8"
                             Opacity="0.35"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>
                    <Ellipse Width="60" Height="60"
                             Stroke="#3DD6A8"
                             StrokeThickness="0.8"
                             Opacity="0.3"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>
                    <Ellipse Width="30" Height="30"
                             Stroke="#3DD6A8"
                             StrokeThickness="0.8"
                             Opacity="0.25"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>

                    <!-- Crosshair лінії -->
                    <Line X1="0" Y1="55" X2="110" Y2="55"
                          Stroke="#3DD6A8"
                          StrokeThickness="0.5"
                          Opacity="0.15"/>
                    <Line X1="55" Y1="0" X2="55" Y2="110"
                          Stroke="#3DD6A8"
                          StrokeThickness="0.5"
                          Opacity="0.15"/>

                    <!-- ══ Sweep Beam — обертовий holographic конус ══ -->
                    <!--
                        Path: сектор 40° з радіальним градієнтом.
                        RotateTransform: 0→360° за 1.8с (RepeatBehavior.Forever).
                        RenderTransformOrigin = центр (0.5, 0.5).
                    -->
                    <Grid Width="100" Height="100"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          ClipToBounds="True">
                        <Path x:Name="SweepBeam"
                              Fill="#1A3DD6A8"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              RenderTransformOrigin="0.5,0.5">
                            <!-- Сектор 40°: центр (50,50), радіус 50, кути 0°→40° -->
                            <Path.Data>
                                <PathGeometry>
                                    <PathFigure StartPoint="50,50" IsClosed="True">
                                        <LineSegment Point="100,50"/>
                                        <ArcSegment Point="88.19,21.92"
                                                    Size="50,50"
                                                    SweepDirection="Clockwise"
                                                    IsLargeArc="False"/>
                                    </PathFigure>
                                </PathGeometry>
                            </Path.Data>
                            <Path.RenderTransform>
                                <RotateTransform x:Name="SweepRotate" Angle="0" CenterX="50" CenterY="50"/>
                            </Path.RenderTransform>
                            <Path.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="SweepRotate"
                                                Storyboard.TargetProperty="Angle"
                                                From="0" To="360"
                                                Duration="0:0:1.8"
                                                RepeatBehavior="Forever"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Path.Triggers>
                        </Path>

                        <!-- Bright leading edge of sweep (thin line) -->
                        <Line x:Name="SweepLine"
                              X1="50" Y1="50" X2="100" Y2="50"
                              Stroke="#3DD6A8"
                              StrokeThickness="1"
                              Opacity="0.5"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              RenderTransformOrigin="0.5,0.5">
                            <Line.RenderTransform>
                                <RotateTransform x:Name="SweepLineRotate" Angle="0" CenterX="50" CenterY="50"/>
                            </Line.RenderTransform>
                            <Line.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="SweepLineRotate"
                                                Storyboard.TargetProperty="Angle"
                                                From="0" To="360"
                                                Duration="0:0:1.8"
                                                RepeatBehavior="Forever"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Line.Triggers>
                        </Line>
                    </Grid>

                    <!-- ══ Центральна точка з пульсацією ══ -->
                    <Ellipse Width="4" Height="4"
                             Fill="#3DD6A8"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="CenterPulse" ScaleX="1" ScaleY="1"/>
                        </Ellipse.RenderTransform>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="CenterPulse"
                                            Storyboard.TargetProperty="ScaleX"
                                            From="0.8" To="1.6"
                                            Duration="0:0:1.2"
                                            AutoReverse="True"
                                            RepeatBehavior="Forever"/>
                                        <DoubleAnimation
                                            Storyboard.TargetName="CenterPulse"
                                            Storyboard.TargetProperty="ScaleY"
                                            From="0.8" To="1.6"
                                            Duration="0:0:1.2"
                                            AutoReverse="True"
                                            RepeatBehavior="Forever"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>

                    <!-- ══ Мерехтливі точки (staggered Opacity) ══ -->
                    <Ellipse Width="2" Height="2" Fill="#3DD6A8"
                             HorizontalAlignment="Left" VerticalAlignment="Top"
                             Margin="22,30,0,0" Opacity="0.2">
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                            From="0.1" To="0.7" Duration="0:0:0.8"
                                            AutoReverse="True" RepeatBehavior="Forever"
                                            BeginTime="0:0:0.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <Ellipse Width="2" Height="2" Fill="#3DD6A8"
                             HorizontalAlignment="Right" VerticalAlignment="Top"
                             Margin="0,40,20,0" Opacity="0.15">
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                            From="0.1" To="0.6" Duration="0:0:1.1"
                                            AutoReverse="True" RepeatBehavior="Forever"
                                            BeginTime="0:0:0.5"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <Ellipse Width="2" Height="2" Fill="#3DD6A8"
                             HorizontalAlignment="Left" VerticalAlignment="Bottom"
                             Margin="35,0,0,22" Opacity="0.2">
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                            From="0.1" To="0.65" Duration="0:0:0.9"
                                            AutoReverse="True" RepeatBehavior="Forever"
                                            BeginTime="0:0:0.8"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <Ellipse Width="2" Height="2" Fill="#3DD6A8"
                             HorizontalAlignment="Right" VerticalAlignment="Bottom"
                             Margin="0,0,30,28" Opacity="0.15">
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                            From="0.1" To="0.55" Duration="0:0:1.3"
                                            AutoReverse="True" RepeatBehavior="Forever"
                                            BeginTime="0:0:0.3"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <Ellipse Width="2" Height="2" Fill="#5FAFE0"
                             HorizontalAlignment="Center" VerticalAlignment="Top"
                             Margin="0,18,0,0" Opacity="0.2">
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                            From="0.1" To="0.5" Duration="0:0:1.5"
                                            AutoReverse="True" RepeatBehavior="Forever"
                                            BeginTime="0:0:1.0"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                </Grid>

                <!-- ── Текст: єдиний нетехнічний рядок ── -->
                <TextBlock x:Name="ScanningLabel"
                           Text="Пошук сигнатур..."
                           FontFamily="Segoe UI Semibold"
                           FontSize="10"
                           Foreground="#5F9FE0"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,2"
                           Opacity="0.8">
                    <TextBlock.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                        From="0.3" To="0.9" Duration="0:0:1.5"
                                        AutoReverse="True" RepeatBehavior="Forever"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </TextBlock.Triggers>
                </TextBlock>

            </StackPanel>

            <!-- ════════════════════════════════════════════════════════════════
                 БЛОК A: Single-candidate (Material, рідкість, зірки, метрики)
                 Visible коли AllCandidates.Count == 1 (або Lost — "Сигнал втрачено").
                 При колізії (Count > 1) приховується, замінюється Блоком B.
                 При скануванні (Count == 0, не Lost) приховується, замінюється Блоком S.
            ════════════════════════════════════════════════════════════════ -->
            <StackPanel x:Name="SingleCandidatePanel"
                        Orientation="Vertical"
                        Visibility="Collapsed">

                <!-- ── Ідентифікація: назва ресурсу (кольорова за рідкістю) ── -->
                <TextBlock x:Name="MaterialName"
                           Text="Сканування..."
                           FontFamily="Segoe UI Semibold"
                           FontSize="15"
                           Foreground="#E8F3FF"
                           HorizontalAlignment="Left"
                           Margin="0,0,0,1"/>

                <!--
                    Підпис рідкості (напр. «Рідкість: Epic»).
                    Розщеплено на два Run, щоб фарбувати лише значення:
                      «Рідкість:» — завжди білий (#E8F3FF)
                      «Epic»      — колір рідкісності (з code-behind)
                -->
                <TextBlock FontFamily="Segoe UI"
                           FontSize="10"
                           HorizontalAlignment="Left"
                           Margin="0,0,0,1">
                    <Run x:Name="RarityLabelPrefix"
                         Text="Рідкість: "
                         Foreground="#E8F3FF"/>
                    <Run x:Name="RarityLabelValue"
                         Text="—"
                         Foreground="#A7C6E7"/>
                </TextBlock>

                <!--
                    Рейтинг зірок (★★★★☆).
                    Колір ЗАВЖДИ яскраво-золотистий (#FFD700), незалежно від рідкісності
                    ресурсу. Code-behind не змінює Foreground — лише Text.
                -->
                <TextBlock x:Name="StarsLabel"
                           Text="☆☆☆☆☆"
                           FontFamily="Segoe UI Symbol"
                           FontSize="11"
                           Foreground="#FFD700"
                           HorizontalAlignment="Left"
                           Margin="0,0,0,6"/>

                <!-- ── Роздільник між ідентифікацією та метриками ── -->
                <Border Height="1"
                        Background="#2A5A78"
                        Margin="0,0,0,6"/>

                <!-- ── Метрики: Кластер / Сигнатура / Сканування (вирівняно через Grid) ── -->
                <Grid HorizontalAlignment="Left"
                      Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Кластер -->
                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="Кластер:"
                               FontFamily="Segoe UI"
                               FontSize="10"
                               Foreground="#5F7E8A"
                               Margin="0,0,8,1"/>
                    <TextBlock Grid.Row="0" Grid.Column="1"
                               x:Name="ClusterInfo"
                               Text="—"
                               FontFamily="Segoe UI Semibold"
                               FontSize="10"
                               Foreground="#E8F3FF"
                               Margin="0,0,0,1"/>

                    <!-- Сигнатура -->
                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Text="Сигнатура:"
                               FontFamily="Segoe UI"
                               FontSize="10"
                               Foreground="#5F7E8A"
                               Margin="0,0,8,1"/>
                    <TextBlock Grid.Row="1" Grid.Column="1"
                               x:Name="SignatureLabel"
                               Text="—"
                               FontFamily="Consolas"
                               FontSize="10"
                               Foreground="#A7C6E7"
                               Margin="0,0,0,1"/>

                    <!-- Сканування (progress bar + %) -->
                    <TextBlock Grid.Row="2" Grid.Column="0"
                               Text="Сканування:"
                               FontFamily="Segoe UI"
                               FontSize="10"
                               Foreground="#5F7E8A"
                               Margin="0,0,8,0"/>
                    <StackPanel Grid.Row="2" Grid.Column="1"
                                Orientation="Horizontal">
                        <TextBlock x:Name="ScanBar"
                                   Text="░░░░░░░░░░"
                                   FontFamily="Consolas"
                                   FontSize="10"
                                   Foreground="#3DD6A8"
                                   Margin="0,0,4,0"/>
                        <TextBlock x:Name="ScanPercent"
                                   Text="0%"
                                   FontFamily="Segoe UI Semibold"
                                   FontSize="10"
                                   Foreground="#A7C6E7"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- ════════════════════════════════════════════════════════════════
                 БЛОК B: Multi-candidate (колізія ROC/FPS/Salvage)
                 Visible коли AllCandidates.Count > 1.
                 Показує сигнатуру + список усіх кандидатів + progress bar.
            ════════════════════════════════════════════════════════════════ -->
            <StackPanel x:Name="MultiCandidatePanel"
                        Orientation="Vertical"
                        Visibility="Collapsed">

                <!-- Сигнатура як заголовок (великий, моноширинний) -->
                <TextBlock x:Name="MultiSignatureLabel"
                           Text="—"
                           FontFamily="Consolas"
                           FontSize="15"
                           Foreground="#E8F3FF"
                           HorizontalAlignment="Left"
                           Margin="0,0,0,1"/>

                <!-- Підзаголовок: кількість кандидатів -->
                <TextBlock x:Name="MultiCountLabel"
                           Text="—"
                           FontFamily="Segoe UI"
                           FontSize="9"
                           Foreground="#5F7E8A"
                           HorizontalAlignment="Left"
                           Margin="0,0,0,4"/>

                <!-- Роздільник перед списком кандидатів -->
                <Border Height="1"
                        Background="#2A5A78"
                        Margin="0,0,0,4"/>

                <!-- Список кандидатів (кожен рядок: → Name   Cluster/Tier) -->
                <ItemsControl x:Name="CandidatesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Стрілка-маркер -->
                                <TextBlock Grid.Column="0"
                                           Text="→"
                                           FontFamily="Segoe UI"
                                           FontSize="10"
                                           Foreground="#5F7E8A"
                                           Margin="0,0,6,0"
                                           VerticalAlignment="Center"/>
                                <!-- Назва (моноширинна, біла) -->
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Name}"
                                           FontFamily="Segoe UI Semibold"
                                           FontSize="10"
                                           Foreground="#E8F3FF"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center"/>
                                <!-- Cluster/Tier (моноширинний, приглушений) -->
                                <TextBlock Grid.Column="2"
                                           Text="{Binding ClusterFormat}"
                                           FontFamily="Consolas"
                                           FontSize="10"
                                           Foreground="#A7C6E7"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Роздільник після списку кандидатів -->
                <Border Height="1"
                        Background="#2A5A78"
                        Margin="0,4,0,6"/>

                <!-- Сканування (progress bar + %) — спільне для всіх кандидатів -->
                <Grid HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Сканування:"
                               FontFamily="Segoe UI"
                               FontSize="10"
                               Foreground="#5F7E8A"
                               Margin="0,0,8,0"/>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal">
                        <TextBlock x:Name="MultiScanBar"
                                   Text="░░░░░░░░░░"
                                   FontFamily="Consolas"
                                   FontSize="10"
                                   Foreground="#3DD6A8"
                                   Margin="0,0,4,0"/>
                        <TextBlock x:Name="MultiScanPercent"
                                   Text="0%"
                                   FontFamily="Segoe UI Semibold"
                                   FontSize="10"
                                   Foreground="#A7C6E7"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- ── Діагностика (низький, лише для дебагу) ── -->
            <TextBlock x:Name="Confidence"
                        Text="—"
                        FontFamily="Consolas"
                        FontSize="8"
                        Foreground="#3D5560"
                        Margin="0,4,0,0"
                        HorizontalAlignment="Left"/>

        </StackPanel>
    </Border>
</Window>
