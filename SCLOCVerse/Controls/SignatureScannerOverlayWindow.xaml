<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av" x:Class="SCLOCVerse.Controls.SignatureScannerOverlayWindow"
        Title="SignatureScanner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Width="187"
        SizeToContent="Height"
        ShowActivated="False" av:DesignHeight="193.415">

    <!--
        Scanner Overlay — єдиний HUD-компонент.
        Width=240 — компактний. Контентна зона 230px, картка 225px.
        Усі 3 режими (Radar, Single, Multi) — у одному Grid, перекриваються.
        Перемикання через Visibility (Collapsed/Visible) — без зміни Window.
    -->
    <Border Background="#CC0A1D29"
            BorderBrush="#2A5A78"
            BorderThickness="1"
            CornerRadius="12"
            Padding="4,6" HorizontalAlignment="Left" Width="187">
        <StackPanel Orientation="Vertical">

            <!-- /ЄДИНИЙ КОНТЕЙНЕР -->

            <!-- ── Шапка: заголовок сканера ── -->
            <TextBlock x:Name="TitleLabel"
                        Text="SC SCAN"
                        FontFamily="Segoe UI Semibold"
                        FontSize="9"
                        Foreground="#5F7E8A"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,4"/>

            <!-- ════════════════════════════════════════════════════════════════
                 ЄДИНИЙ КОНТЕЙНЕР: Grid з 3 режимами, що перекриваються.
            ════════════════════════════════════════════════════════════════ -->
            <Grid>

                <!-- ════════════════════════════════════════════════════════════════
                 БЛОК S: Scanning Radar (стан очікування) — V2 Holographic
            ════════════════════════════════════════════════════════════════ -->
                <StackPanel x:Name="ScanningPanel"
                        Orientation="Vertical"
                        Visibility="Visible"
                        Opacity="1">

                    <!-- ── Радар 140×140 (Grid=Auto — не обрізає stroke кільця) ── -->
                    <Grid Width="Auto"
                      HorizontalAlignment="Center"
                      Margin="0,2,0,0">

                        <!-- ── Background disc: radial gradient (depth, glass) ── -->
                        <Ellipse Width="140" Height="140"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center">
                            <Ellipse.Fill>
                                <RadialGradientBrush Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                                    <GradientStop Offset="0.0" Color="#10304030"/>
                                    <GradientStop Offset="0.7" Color="#08182820"/>
                                    <GradientStop Offset="1.0" Color="#00000000"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>

                        <!-- ── Outer ring з glow ── -->
                        <Ellipse Width="138" Height="138"
                             Stroke="#2A5A78"
                             StrokeThickness="1.5"
                             Opacity="0.85"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>
                        <Ellipse Width="138" Height="138"
                             Stroke="#3DD6A8"
                             StrokeThickness="0.6"
                             Opacity="0.5"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>

                        <!-- ══ Концентричні кільця з breathing (99→101%) ══ -->
                        <Ellipse Width="100" Height="100"
                             Stroke="#3DD6A8"
                             StrokeThickness="0.8"
                             Opacity="0.55"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform x:Name="Ring1Breath" ScaleX="1" ScaleY="1"/>
                            </Ellipse.RenderTransform>
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Ring1Breath"
                                                Storyboard.TargetProperty="ScaleX"
                                                From="0.99" To="1.01" Duration="0:0:2.5"
                                                AutoReverse="True" RepeatBehavior="Forever"/>
                                            <DoubleAnimation Storyboard.TargetName="Ring1Breath"
                                                Storyboard.TargetProperty="ScaleY"
                                                From="0.99" To="1.01" Duration="0:0:2.5"
                                                AutoReverse="True" RepeatBehavior="Forever"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                        <Ellipse Width="66" Height="66"
                             Stroke="#3DD6A8"
                             StrokeThickness="0.8"
                             Opacity="0.5"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform x:Name="Ring2Breath" ScaleX="1" ScaleY="1"/>
                            </Ellipse.RenderTransform>
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Ring2Breath"
                                                Storyboard.TargetProperty="ScaleX"
                                                From="0.99" To="1.01" Duration="0:0:2.0"
                                                AutoReverse="True" RepeatBehavior="Forever"
                                                BeginTime="0:0:0.3"/>
                                            <DoubleAnimation Storyboard.TargetName="Ring2Breath"
                                                Storyboard.TargetProperty="ScaleY"
                                                From="0.99" To="1.01" Duration="0:0:2.0"
                                                AutoReverse="True" RepeatBehavior="Forever"
                                                BeginTime="0:0:0.3"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                        <Ellipse Width="34" Height="34"
                             Stroke="#3DD6A8"
                             StrokeThickness="0.8"
                             Opacity="0.45"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform x:Name="Ring3Breath" ScaleX="1" ScaleY="1"/>
                            </Ellipse.RenderTransform>
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Ring3Breath"
                                                Storyboard.TargetProperty="ScaleX"
                                                From="0.99" To="1.01" Duration="0:0:1.8"
                                                AutoReverse="True" RepeatBehavior="Forever"
                                                BeginTime="0:0:0.6"/>
                                            <DoubleAnimation Storyboard.TargetName="Ring3Breath"
                                                Storyboard.TargetProperty="ScaleY"
                                                From="0.99" To="1.01" Duration="0:0:1.8"
                                                AutoReverse="True" RepeatBehavior="Forever"
                                                BeginTime="0:0:0.6"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>

                        <!-- ── Crosshair лінії (приглушені, holo) ── -->
                        <Line X1="0" Y1="70" X2="140" Y2="70"
                              Stroke="#3DD6A8"
                              StrokeThickness="0.5"
                              Opacity="0.22"/>
                        <Line X1="70" Y1="0" X2="70" Y2="140"
                              Stroke="#3DD6A8"
                              StrokeThickness="0.5"
                              Opacity="0.22"/>

                        <!-- ════════════════════════════════════════════════════════════════
                             SWEEP CONE — радіальний holographic промінь з центру
                             Canvas 140×140: абсолютні координати, без змін.
                             (70,70) = центр Canvas = центр радара.
                        ════════════════════════════════════════════════════════════════ -->
                        <Canvas Width="140" Height="140"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                ClipToBounds="True">

                            <!-- Echo blips: синхронно з проходженням sweep -->
                            <!-- Sweep cone: сектор 50° з центру (70,70) -->
                            <Path x:Name="SweepCone">
                                <Path.Data>
                                    <PathGeometry Figures="M70,70 L138,70 A68,68,0,0,1,113.7,17.9 z"/>
                                </Path.Data>
                                <Path.Fill>
                                    <RadialGradientBrush
                                        Center="0.93,0.5"
                                        RadiusX="0.5"
                                        RadiusY="0.5"
                                        GradientOrigin="0.93,0.5">
                                        <GradientStop Offset="0.0" Color="#663DD6A8"/>
                                        <GradientStop Offset="0.15" Color="#403DD6A8"/>
                                        <GradientStop Offset="0.5" Color="#183DD6A8"/>
                                        <GradientStop Offset="1.0" Color="#003DD6A8"/>
                                    </RadialGradientBrush>
                                </Path.Fill>
                                <Path.RenderTransform>
                                    <RotateTransform x:Name="SweepRotate" Angle="0" CenterX="70" CenterY="70"/>
                                </Path.RenderTransform>
                                <Path.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetName="SweepRotate"
                                                    Storyboard.TargetProperty="Angle"
                                                    From="0" To="360"
                                                    Duration="0:0:2"
                                                    RepeatBehavior="Forever"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Path.Triggers>
                            </Path>

                            <!-- Яскрава передня грань (leading edge) -->
                            <Line x:Name="SweepLeadingEdge"
                                  X1="70" Y1="70" X2="138" Y2="70"
                                  Stroke="#9FFFE0"
                                  StrokeThickness="1.2"
                                  Opacity="0.8">
                                <Line.RenderTransform>
                                    <RotateTransform x:Name="SweepLineRotate" Angle="0" CenterX="70" CenterY="70"/>
                                </Line.RenderTransform>
                                <Line.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetName="SweepLineRotate"
                                                    Storyboard.TargetProperty="Angle"
                                                    From="0" To="360"
                                                    Duration="0:0:2"
                                                    RepeatBehavior="Forever"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Line.Triggers>
                            </Line>

                            <!-- Blip 1: координати рандомізуються при вході в Scanning -->
                            <Ellipse x:Name="Blip1" Width="3" Height="3"
                                     Canvas.Left="115" Canvas.Top="39"
                                     Fill="#3DD6A8"
                                     Opacity="0"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="Blip1Scale" ScaleX="0.3" ScaleY="0.3"/>
                                </Ellipse.RenderTransform>
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Blip1Scale"
                                                    Storyboard.TargetProperty="ScaleX"
                                                    From="0.3" To="1.8" Duration="0:0:0.4"
                                                    AutoReverse="True" RepeatBehavior="Forever"
                                                    BeginTime="0:0:0.17"/>
                                                <DoubleAnimation Storyboard.TargetName="Blip1Scale"
                                                    Storyboard.TargetProperty="ScaleY"
                                                    From="0.3" To="1.8" Duration="0:0:0.4"
                                                    AutoReverse="True" RepeatBehavior="Forever"
                                                    BeginTime="0:0:0.17"/>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                    From="0" To="0.9" Duration="0:0:0.4"
                                                    AutoReverse="True" RepeatBehavior="Forever"
                                                    BeginTime="0:0:0.17"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>

                            <!-- Blip 2 -->
                            <Ellipse x:Name="Blip2" Width="3" Height="3"
                                     Canvas.Left="46" Canvas.Top="11"
                                     Fill="#3DD6A8"
                                     Opacity="0"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="Blip2Scale" ScaleX="0.3" ScaleY="0.3"/>
                                </Ellipse.RenderTransform>
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Blip2Scale"
                                                    Storyboard.TargetProperty="ScaleX"
                                                    From="0.3" To="1.6" Duration="0:0:0.35"
                                                    AutoReverse="True" RepeatBehavior="Forever"
                                                    BeginTime="0:0:0.67"/>
                                                <DoubleAnimation Storyboard.TargetName="Blip2Scale"
                                                    Storyboard.TargetProperty="ScaleY"
                                                    From="0.3" To="1.6" Duration="0:0:0.35"
                                                    AutoReverse="True" RepeatBehavior="Forever"
                                                    BeginTime="0:0:0.67"/>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                    From="0" To="0.8" Duration="0:0:0.35"
                                                    AutoReverse="True" RepeatBehavior="Forever"
                                                    BeginTime="0:0:0.67"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>

                            <!-- Blip 3 -->
                            <Ellipse x:Name="Blip3" Width="3" Height="3"
                                     Canvas.Left="18" Canvas.Top="104"
                                     Fill="#5FAFE0"
                                     Opacity="0"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="Blip3Scale" ScaleX="0.3" ScaleY="0.3"/>
                                </Ellipse.RenderTransform>
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Blip3Scale"
                                                    Storyboard.TargetProperty="ScaleX"
                                                    From="0.3" To="1.7" Duration="0:0:0.4"
                                                    AutoReverse="True" RepeatBehavior="Forever"
                                                    BeginTime="0:0:1.22"/>
                                                <DoubleAnimation Storyboard.TargetName="Blip3Scale"
                                                    Storyboard.TargetProperty="ScaleY"
                                                    From="0.3" To="1.7" Duration="0:0:0.4"
                                                    AutoReverse="True" RepeatBehavior="Forever"
                                                    BeginTime="0:0:1.22"/>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                    From="0" To="0.85" Duration="0:0:0.4"
                                                    AutoReverse="True" RepeatBehavior="Forever"
                                                    BeginTime="0:0:1.22"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>

                            <!-- Blip 4 -->
                            <Ellipse x:Name="Blip4" Width="3" Height="3"
                                     Canvas.Left="104" Canvas.Top="122"
                                     Fill="#3DD6A8"
                                     Opacity="0"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="Blip4Scale" ScaleX="0.3" ScaleY="0.3"/>
                                </Ellipse.RenderTransform>
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Blip4Scale"
                                                    Storyboard.TargetProperty="ScaleX"
                                                    From="0.3" To="1.5" Duration="0:0:0.35"
                                                    AutoReverse="True" RepeatBehavior="Forever"
                                                    BeginTime="0:0:1.67"/>
                                                <DoubleAnimation Storyboard.TargetName="Blip4Scale"
                                                    Storyboard.TargetProperty="ScaleY"
                                                    From="0.3" To="1.5" Duration="0:0:0.35"
                                                    AutoReverse="True" RepeatBehavior="Forever"
                                                    BeginTime="0:0:1.67"/>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                    From="0" To="0.75" Duration="0:0:0.35"
                                                    AutoReverse="True" RepeatBehavior="Forever"
                                                    BeginTime="0:0:1.67"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                        </Canvas>

                        <!-- ════════════════════════════════════════════════════════════════
                             ЦЕНТРАЛЬНИЙ EMITTER — glow + pulse
                        ════════════════════════════════════════════════════════════════ -->

                        <!-- Outer glow halo -->
                        <Ellipse Width="16" Height="16"
                                 Fill="#103DD6A8"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 RenderTransformOrigin="0.5,0.5"
                                 Opacity="0.3">
                            <Ellipse.RenderTransform>
                                <ScaleTransform x:Name="CenterGlowOuter" ScaleX="1" ScaleY="1"/>
                            </Ellipse.RenderTransform>
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CenterGlowOuter"
                                                Storyboard.TargetProperty="ScaleX"
                                                From="0.8" To="1.8" Duration="0:0:1.5"
                                                AutoReverse="True" RepeatBehavior="Forever"/>
                                            <DoubleAnimation Storyboard.TargetName="CenterGlowOuter"
                                                Storyboard.TargetProperty="ScaleY"
                                                From="0.8" To="1.8" Duration="0:0:1.5"
                                                AutoReverse="True" RepeatBehavior="Forever"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>

                        <!-- Mid glow -->
                        <Ellipse Width="8" Height="8"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.Fill>
                                <RadialGradientBrush Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                                    <GradientStop Offset="0.0" Color="#AA3DD6A8"/>
                                    <GradientStop Offset="0.6" Color="#553DD6A8"/>
                                    <GradientStop Offset="1.0" Color="#003DD6A8"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                            <Ellipse.RenderTransform>
                                <ScaleTransform x:Name="CenterGlowMid" ScaleX="1" ScaleY="1"/>
                            </Ellipse.RenderTransform>
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CenterGlowMid"
                                                Storyboard.TargetProperty="ScaleX"
                                                From="0.9" To="1.4" Duration="0:0:1.2"
                                                AutoReverse="True" RepeatBehavior="Forever"/>
                                            <DoubleAnimation Storyboard.TargetName="CenterGlowMid"
                                                Storyboard.TargetProperty="ScaleY"
                                                From="0.9" To="1.4" Duration="0:0:1.2"
                                                AutoReverse="True" RepeatBehavior="Forever"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>

                        <!-- Inner core (яскравий) -->
                        <Ellipse Width="4" Height="4"
                                 Fill="#CFFFE8"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform x:Name="CenterCore" ScaleX="1" ScaleY="1"/>
                            </Ellipse.RenderTransform>
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CenterCore"
                                                Storyboard.TargetProperty="ScaleX"
                                                From="0.7" To="1.3" Duration="0:0:1.0"
                                                AutoReverse="True" RepeatBehavior="Forever"/>
                                            <DoubleAnimation Storyboard.TargetName="CenterCore"
                                                Storyboard.TargetProperty="ScaleY"
                                                From="0.7" To="1.3" Duration="0:0:1.0"
                                                AutoReverse="True" RepeatBehavior="Forever"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                    </Grid>

                    <!-- ── Текст: єдиний нетехнічний рядок ── -->
                    <TextBlock x:Name="ScanningLabel"
                           Text="Пошук сигнатур..."
                           FontFamily="Segoe UI Semibold"
                           FontSize="10"
                           Foreground="#5F9FE0"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,2"
                           Opacity="0.8">
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                        From="0.3" To="0.9" Duration="0:0:1.5"
                                        AutoReverse="True" RepeatBehavior="Forever"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TextBlock.Triggers>
                    </TextBlock>

                </StackPanel>

                <!-- ════════════════════════════════════════════════════════════════
                 БЛОК A: Single-candidate (Material, рідкість, зірки, метрики)
                 Visible коли AllCandidates.Count == 1 (або Lost — "Сигнал втрачено").
                 При колізії (Count > 1) приховується, замінюється Блоком B.
                 При скануванні (Count == 0, не Lost) приховується, замінюється Блоком S.
            ════════════════════════════════════════════════════════════════ -->
                <StackPanel x:Name="SingleCandidatePanel"
                        Orientation="Vertical"
                        Visibility="Collapsed">

                    <!-- ── Заокруглена картка Single-candidate ── -->
                    <Border Background="#14203040"
                        CornerRadius="8"
                        Padding="2,4"
                        BorderBrush="#1A3A5A"
                        BorderThickness="0.5"
                        Margin="0,0,0,0">
                        <StackPanel Orientation="Vertical">

                            <!-- ── Ідентифікація: назва ресурсу (кольорова за рідкістю) ── -->
                            <TextBlock x:Name="MaterialName"
                           Text="Сигнал..."
                           FontFamily="Segoe UI Semibold"
                           FontSize="15"
                           Foreground="#E8F3FF"
                           HorizontalAlignment="Left"
                           Margin="0,0,0,6"/>

                            <!--
                    Підпис рідкості (напр. «Рідкість: Epic»).
                    Розщеплено на два Run, щоб фарбувати лише значення:
                      «Рідкість:» — завжди білий (#E8F3FF)
                      «Epic»      — колір рідкісності (з code-behind)
                -->
                            <TextBlock FontFamily="Segoe UI"
                           FontSize="10"
                           HorizontalAlignment="Left"
                           Margin="0,0,0,5"><Run x:Name="RarityLabelPrefix"
                         Text="Рідкість: "
                         Foreground="#E8F3FF"/><Run Text=" "/><Run x:Name="RarityLabelValue"
                         Text="—"
                         Foreground="#A7C6E7"/></TextBlock>

                            <!--
                    Рейтинг зірок (★★★★☆).
                    Колір ЗАВЖДИ яскраво-золотистий (#FFD700), незалежно від рідкісності
                    ресурсу. Code-behind не змінює Foreground — лише Text.
                -->
                            <TextBlock x:Name="StarsLabel"
                           Text="☆☆☆☆☆"
                           FontFamily="Segoe UI Symbol"
                           FontSize="11"
                           Foreground="#FFD700"
                           HorizontalAlignment="Left"
                           Margin="0,0,0,12"/>

                            <!-- ── Роздільник між ідентифікацією та метриками ── -->
                            <Border Height="1"
                        Background="#2A5A78"
                        Margin="0,0,0,10"/>

                            <!-- ── Метрики: Кластер / Сигнатура (вирівняно через Grid) ── -->
                            <Grid HorizontalAlignment="Left"
                      Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Кластер -->
                                <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="Кластер:"
                               FontFamily="Segoe UI"
                               FontSize="10"
                               Foreground="#5F7E8A"
                               Margin="0,0,8,4"/>
                                <TextBlock Grid.Row="0" Grid.Column="1"
                               x:Name="ClusterInfo"
                               Text="—"
                               FontFamily="Segoe UI Semibold"
                               FontSize="10"
                               Foreground="#E8F3FF"
                               Margin="0,0,0,4"/>

                                <!-- Сигнатура -->
                                <TextBlock Grid.Row="1" Grid.Column="0"
                               Text="Сигнатура:"
                               FontFamily="Segoe UI"
                               FontSize="10"
                               Foreground="#5F7E8A"
                               Margin="0,0,8,4"/>
                                <TextBlock Grid.Row="1" Grid.Column="1"
                                x:Name="SignatureLabel"
                                Text="—"
                                FontFamily="Consolas"
                                FontSize="10"
                                FontWeight="Bold"
                                Foreground="#A7C6E7"
                                 Margin="0,0,0,4"/>
                            </Grid>

                            <!-- ── Роздільник перед блоком сканування ── -->
                            <Border Height="1"
                        Background="#2A5A78"
                        Margin="0,0,0,8"/>

                            <!-- ── Блок сканування ── -->
                            <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,4">
                                <TextBlock Text="Сигнал:"
                               FontFamily="Segoe UI"
                               FontSize="10"
                               Foreground="#5F7E8A"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                                <Border x:Name="ScanBarTrack"
                                       Width="60" Height="10"
                                       Background="#0E3D5560"
                                       CornerRadius="2"
                                       BorderBrush="#1A3A5A"
                                       BorderThickness="0.5"
                                       ClipToBounds="True"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0">
                                    <Rectangle x:Name="ScanBarFill"
                                               Width="0"
                                               Height="10"
                                               HorizontalAlignment="Left"
                                               Fill="#3DD6A8"/>
                                </Border>
                                <TextBlock x:Name="ScanPercent"
                               Text="0%"
                               FontFamily="Segoe UI Semibold"
                               FontSize="11"
                               Foreground="#A7C6E7"
                                VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <!-- /Single-candidate картка -->

                </StackPanel>

                <!-- ════════════════════════════════════════════════════════════════
                 БЛОК B: Multi-candidate (колізія ROC/FPS/Salvage)
                 Visible коли AllCandidates.Count > 1.
                 Показує сигнатуру + список усіх кандидатів + progress bar.
            ════════════════════════════════════════════════════════════════ -->
                <StackPanel x:Name="MultiCandidatePanel"
                        Orientation="Vertical"
                        Visibility="Collapsed">

                    <!-- ── Заокруглена картка Multi-candidate ── -->
                    <Border Background="#14203040"
                        CornerRadius="8"
                        Padding="2,4"
                        BorderBrush="#1A3A5A"
                        BorderThickness="0.5"
                        Margin="0,0,0,0">
                        <StackPanel Orientation="Vertical">

                            <!-- Сигнатура як заголовок (великий, моноширинний) -->
                            <TextBlock x:Name="MultiSignatureLabel"
                           Text="—"
                           FontFamily="Consolas"
                           FontSize="15"
                           Foreground="#E8F3FF"
                           HorizontalAlignment="Left"
                           Margin="0,0,0,1"/>

                            <!-- Підзаголовок: кількість кандидатів -->
                            <TextBlock x:Name="MultiCountLabel"
                           Text="—"
                           FontFamily="Segoe UI"
                           FontSize="9"
                           Foreground="#5F7E8A"
                           HorizontalAlignment="Left"
                           Margin="0,0,0,4"/>

                            <!-- Роздільник перед списком кандидатів -->
                            <Border Height="1"
                        Background="#2A5A78"
                        Margin="0,0,0,4"/>

                            <!-- Список кандидатів (кожен рядок: → Name   Cluster/Tier) -->
                            <ItemsControl x:Name="CandidatesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- Стрілка-маркер -->
                                            <TextBlock Grid.Column="0"
                                           Text="→"
                                           FontFamily="Segoe UI"
                                           FontSize="10"
                                           Foreground="#5F7E8A"
                                           Margin="0,0,6,0"
                                           VerticalAlignment="Center"/>
                                            <!-- Назва (моноширинна, біла) -->
                                            <TextBlock Grid.Column="1"
                                           Text="{Binding Name}"
                                           FontFamily="Segoe UI Semibold"
                                           FontSize="10"
                                           Foreground="#E8F3FF"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center"/>
                                            <!-- Cluster/Tier (моноширинний, приглушений) -->
                                            <TextBlock Grid.Column="2"
                                           Text="{Binding ClusterFormat}"
                                           FontFamily="Consolas"
                                           FontSize="10"
                                           Foreground="#A7C6E7"
                                           VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Роздільник після списку кандидатів -->
                            <Border Height="1"
                        Background="#2A5A78"
                        Margin="0,4,0,6"/>

                            <!-- Сигнал (progress bar + %) — спільне для всіх кандидатів -->
                            <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,0">
                                <TextBlock Text="Сигнал:"
                               FontFamily="Segoe UI"
                               FontSize="10"
                               Foreground="#5F7E8A"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                                <Border x:Name="MultiScanBarTrack"
                                       Width="60" Height="10"
                                       Background="#0E3D5560"
                                       CornerRadius="2"
                                       BorderBrush="#1A3A5A"
                                       BorderThickness="0.5"
                                       ClipToBounds="True"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0">
                                    <Rectangle x:Name="MultiScanBarFill"
                                               Width="0"
                                               Height="10"
                                               HorizontalAlignment="Left"
                                               Fill="#3DD6A8"/>
                                </Border>
                                <TextBlock x:Name="MultiScanPercent"
                               Text="0%"
                               FontFamily="Segoe UI Semibold"
                               FontSize="11"
                               Foreground="#A7C6E7"
                                VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <!-- /Multi-candidate картка -->

                </StackPanel>

            </Grid>
            <!-- ── Діагностика (низький, лише для дебагу) ── -->
            <TextBlock x:Name="Confidence"
                        Text="—"
                        FontFamily="Consolas"
                        FontSize="8"
                        Foreground="#3D5560"
                        Margin="0,4,0,0"
                        HorizontalAlignment="Left"/>

        </StackPanel>
    </Border>
</Window>
