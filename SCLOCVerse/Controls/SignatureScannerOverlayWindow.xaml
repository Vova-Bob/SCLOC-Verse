<Window x:Class="SCLOCVerse.Controls.SignatureScannerOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SignatureScanner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        ShowActivated="False">

    <Border Background="#CC0A1D29"
            BorderBrush="#2A5A78"
            BorderThickness="1.5"
            CornerRadius="10"
            Padding="12,8">
        <StackPanel Orientation="Vertical">
            <TextBlock x:Name="TitleLabel"
                       Text="SC SCAN"
                       FontFamily="Segoe UI Semibold"
                       FontSize="10"
                       Foreground="#5F7E8A"
                       HorizontalAlignment="Left"
                       Margin="0,0,0,2"/>
            <TextBlock x:Name="MaterialName"
                       Text="Сканування..."
                       FontFamily="Segoe UI Semibold"
                       FontSize="14"
                       Foreground="#E8F3FF"
                       HorizontalAlignment="Left"/>
            <TextBlock x:Name="ClusterInfo"
                       Text="—"
                       FontFamily="Segoe UI"
                       FontSize="11"
                       Foreground="#A7C6E7"
                       Margin="0,4,0,0"
                       HorizontalAlignment="Left"/>
            <TextBlock x:Name="Confidence"
                       Text="—"
                       FontFamily="Consolas"
                       FontSize="9"
                       Foreground="#5F7E8A"
                       Margin="0,2,0,0"
                       HorizontalAlignment="Left"/>
        </StackPanel>
    </Border>
</Window>