<UserControl x:Class="SCLOCVerse.Controls.AppUpdateProgressBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Top"
             Visibility="Collapsed"
             Opacity="0"
             RenderTransformOrigin="0.5,0"
             Margin="90,45,90,0"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display">

    <UserControl.Resources>
        <SolidColorBrush x:Key="BannerBackground" Color="#0A1D29"/>
        <SolidColorBrush x:Key="BannerBorder" Color="#6DB9F8"/>
        <SolidColorBrush x:Key="BannerAccent" Color="#8DD0FF"/>
        <SolidColorBrush x:Key="BannerText" Color="White"/>
        <SolidColorBrush x:Key="BannerSecondaryText" Color="#C7DDF0"/>
        <SolidColorBrush x:Key="ProgressFill" Color="#2196F3"/>
        <SolidColorBrush x:Key="ProgressTrack" Color="#1F3C4C"/>

        <Storyboard x:Key="ShowStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0" To="1"
                             Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="-20" To="0"
                             Duration="0:0:0.25"/>
        </Storyboard>

        <Storyboard x:Key="HideStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="1" To="0"
                             Duration="0:0:0.25"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="0" To="-20"
                             Duration="0:0:0.25"/>
            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility"
                                              Completed="HideStoryboard_Completed">
                <DiscreteObjectKeyFrame KeyTime="0:0:0.25" Value="{x:Static Visibility.Collapsed}"/>
            </ObjectAnimationUsingKeyFrames>
        </Storyboard>

        <Style x:Key="AppUpdateProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="12"/>
            <Setter Property="Background" Value="{StaticResource ProgressTrack}"/>
            <Setter Property="Foreground" Value="{StaticResource ProgressFill}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="TemplateRoot"
                               SnapsToDevicePixels="True">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="6"
                                    Height="{TemplateBinding Height}"/>
                            <Border x:Name="PART_Track"
                                    Background="Transparent"
                                    CornerRadius="6"
                                    Height="{TemplateBinding Height}">
                                <Border x:Name="PART_Indicator"
                                        Background="{TemplateBinding Foreground}"
                                        CornerRadius="6"
                                        HorizontalAlignment="Left"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <UserControl.RenderTransform>
        <TranslateTransform Y="-20"/>
    </UserControl.RenderTransform>

    <Border Background="{StaticResource BannerBackground}"
            CornerRadius="10"
            BorderBrush="{StaticResource BannerBorder}"
            BorderThickness="1"
            Padding="18,12">
        <Border.Effect>
            <DropShadowEffect Color="#6DB9F8"
                             BlurRadius="20"
                             ShadowDepth="0"
                             Opacity="0.35"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock FontFamily="Segoe MDL2 Assets"
                           FontSize="16"
                           Text="&#xE896;"
                           Foreground="{StaticResource BannerAccent}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                
                <TextBlock x:Name="StageTextBlock"
                           FontFamily="Arial"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="{StaticResource BannerText}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <ProgressBar x:Name="ProgressBar"
                         Grid.Row="1"
                         Style="{StaticResource AppUpdateProgressBarStyle}"
                         Minimum="0"
                         Maximum="100"
                         Value="0"
                         Margin="0,0,0,8"/>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock x:Name="PercentageTextBlock"
                               FontFamily="Segoe UI"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="{StaticResource BannerAccent}"
                               Margin="0,0,12,0"/>
                    
                    <TextBlock x:Name="SizeTextBlock"
                               FontFamily="Segoe UI"
                               FontSize="13"
                               Foreground="{StaticResource BannerSecondaryText}"
                               Margin="0,0,12,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="SpeedTextBlock"
                               FontFamily="Segoe UI"
                               FontSize="13"
                               Foreground="{StaticResource BannerSecondaryText}"
                               Margin="0,0,12,0"/>
                    
                    <TextBlock x:Name="EtaTextBlock"
                               FontFamily="Segoe UI"
                               FontSize="13"
                               Foreground="{StaticResource BannerSecondaryText}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
