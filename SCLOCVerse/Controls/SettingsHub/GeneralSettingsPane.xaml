<UserControl x:Class="SCLOCVerse.Controls.SettingsHub.GeneralSettingsPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SCLOCVerse;component/Resources/Styles.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/SCLOCVerse;component/Resources/SettingsHubKit.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Локальні стилі path-кнопок (поведінка Автопошук/Скинути керується MainWindow) -->
            <SolidColorBrush x:Key="BtnFill"        Color="#30546E"/>
            <SolidColorBrush x:Key="BtnFillHover"   Color="#3A6682"/>
            <SolidColorBrush x:Key="BtnStroke"      Color="#8DD0FF"/>
            <SolidColorBrush x:Key="AutoFill"       Color="#1A5474"/>
            <SolidColorBrush x:Key="AutoFillHover"  Color="#2478A9"/>
            <SolidColorBrush x:Key="ResetFill"      Color="#7E2D2D"/>
            <SolidColorBrush x:Key="ResetFillHover" Color="#933838"/>

            <Style x:Key="ActionButton" TargetType="{x:Type Button}">
                <Setter Property="Height" Value="34"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="Foreground" Value="#EAF4FF"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Background" Value="{StaticResource BtnFill}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7" Padding="14,0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource BtnFillHover}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#2A4658"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="AutoSearchButton" TargetType="{x:Type Button}" BasedOn="{StaticResource ActionButton}">
                <Style.Triggers>
                    <Trigger Property="Content" Value="Автопошук">
                        <Setter Property="Background" Value="#1A5474"/>
                        <Setter Property="BorderBrush" Value="#4AA3D8"/>
                    </Trigger>
                    <Trigger Property="Content" Value="Скинути">
                        <!-- P1: скидання шляху — нейтральне, не небезпечне (не червоне) -->
                        <Setter Property="Background" Value="#3A4A56"/>
                        <Setter Property="BorderBrush" Value="#5A7080"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="UpdateChannelComboBoxStyle" TargetType="{x:Type ComboBox}">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Background" Value="#0A1D29"/>
                <Setter Property="BorderBrush" Value="#2A5A78"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ComboBox}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.ColumnSpan="2" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"/>
                                <ContentPresenter Grid.Column="0" Margin="10,0,4,0" VerticalAlignment="Center"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                  IsHitTestVisible="False"/>
                                <ToggleButton Grid.Column="1" Width="22" Height="22" Margin="0,0,3,0"
                                              Background="Transparent" BorderBrush="{x:Null}" Focusable="False"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <Path Data="M0,5 L6,11 L12,5" Stroke="#4AA3D8" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </ToggleButton>
                                <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                       PopupAnimation="Fade" AllowsTransparency="True" StaysOpen="False" MinWidth="{TemplateBinding ActualWidth}">
                                    <Border Background="#0A1D29" BorderBrush="#2A5A78" BorderThickness="1" CornerRadius="6">
                                        <ScrollViewer MaxHeight="200" CanContentScroll="True" HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="{x:Type ComboBoxItem}">
                            <Setter Property="Foreground" Value="#E8F3FF"/>
                            <Setter Property="Padding" Value="10,6"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                                        <Border Name="Bd" Background="{TemplateBinding Background}">
                                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Bd" Property="Background" Value="#162E42"/></Trigger>
                                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="#2478A9"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Рядок налаштування: назва+опис ліворуч, контрол у правій колонці (P4) -->
            <Style x:Key="HubSettingRow" TargetType="Grid">
                <Setter Property="MinHeight" Value="48"/>
                <Setter Property="Margin" Value="0,2"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
        <StackPanel Orientation="Vertical" Margin="0,0,0,16">

            <!-- Cat-head -->
            <StackPanel Orientation="Horizontal" Margin="2,0,0,4">
                <TextBlock Text="ЗАГАЛЬНЕ" FontFamily="Segoe UI" FontSize="15" FontWeight="Bold" Foreground="#EAF4FF"/>
                <TextBlock x:Name="SubtitleText" Margin="12,0,0,0" FontFamily="Segoe UI" FontSize="11.5" Foreground="#5A7A8A" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Style="{StaticResource HubHelpText}" Text="Стан гри, запуск, оновлення та обслуговування."/>

            <!-- ============ STAR CITIZEN ============ -->
            <Border Style="{StaticResource HubGroupCard}">
                <StackPanel Orientation="Vertical">
                    <TextBlock Style="{StaticResource HubGroupLabel}" Text="STAR CITIZEN"/>
                    <TextBlock Style="{StaticResource HubFieldLabel}" Text="Шлях до папки гри"/>
                    <TextBlock Style="{StaticResource HubFieldDesc}" Text="Використовується для встановлення локалізації та конфігурації."/>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Height="34" CornerRadius="6" BorderBrush="#2A5A78" BorderThickness="1" Background="#0A1D29" Margin="0,0,8,0">
                            <TextBox x:Name="TxtSelectedPath" FontFamily="Segoe UI Semibold" FontSize="13" Foreground="#A7C6E7"
                                     Background="Transparent" BorderThickness="0" Padding="12,0" IsReadOnly="True"
                                     HorizontalContentAlignment="Left" VerticalContentAlignment="Center"/>
                        </Border>
                        <Button x:Name="BtnSelectFolder" Grid.Column="1" Style="{StaticResource HubSecondaryButton}" Content="Огляд…" Width="100" Margin="0,0,8,0"/>
                        <Button x:Name="BtnAutoSearch" Grid.Column="2" Style="{StaticResource AutoSearchButton}" Content="Автопошук" Width="118"/>
                    </Grid>
                    <!-- Бейджі середовищ (P0 — стан видимий; заповнюються з StarCitizenEnvironments.DetectExisting) -->
                    <StackPanel x:Name="EnvBadgesPanel" Orientation="Horizontal" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

            <!-- ============ ЗАПУСК ============ -->
            <Border Style="{StaticResource HubGroupCard}">
                <StackPanel Orientation="Vertical">
                    <TextBlock Style="{StaticResource HubGroupLabel}" Text="ЗАПУСК"/>
                    <Grid Style="{StaticResource HubSettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource HubFieldLabel}" Text="Автозапуск із Windows"/>
                            <TextBlock Style="{StaticResource HubFieldDesc}" Text="Запускати SCLOC-Verse після входу до системи."/>
                        </StackPanel>
                        <CheckBox x:Name="RunAtStartupCheckBox" Grid.Column="1" Style="{StaticResource HubToggle}" ToolTip="Автозапуск синхронізується з реєстром Windows."/>
                    </Grid>
                    <Border Height="1" Background="#1E4357" Margin="0,2"/>
                    <Grid Style="{StaticResource HubSettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource HubFieldLabel}" Text="Згортати в трей при закритті"/>
                            <TextBlock Style="{StaticResource HubFieldDesc}" Text="Замість виходу — іконка в системному лотку."/>
                        </StackPanel>
                        <CheckBox x:Name="MinimizeToTrayCheckBox" Grid.Column="1" Style="{StaticResource HubToggle}" ToolTip="При закритті вікна програма залишиться у системному треї."/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ============ ОНОВЛЕННЯ ============ -->
            <Border Style="{StaticResource HubGroupCard}">
                <StackPanel Orientation="Vertical">
                    <TextBlock Style="{StaticResource HubGroupLabel}" Text="ОНОВЛЕННЯ"/>
                    <Grid Style="{StaticResource HubSettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource HubFieldLabel}" Text="Автооновлення локалізації"/>
                            <TextBlock Style="{StaticResource HubFieldDesc}" Text="Перевіряти та встановлювати оновлення перекладу перед запуском гри."/>
                        </StackPanel>
                        <CheckBox x:Name="AutoUpdateLocalizationCheckBox" Grid.Column="1" Style="{StaticResource HubToggle}" ToolTip="Автоматично перевіряти та встановлювати нові версії локалізації."/>
                    </Grid>
                    <Border Height="1" Background="#1E4357" Margin="0,2"/>
                    <Grid Style="{StaticResource HubSettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource HubFieldLabel}" Text="Канал оновлень"/>
                            <TextBlock Style="{StaticResource HubFieldDesc}" Text="Які збірки застосунку пропонувати при перевірці нової версії."/>
                        </StackPanel>
                        <ComboBox x:Name="UpdateChannelComboBox" Grid.Column="1" Width="150" DisplayMemberPath="DisplayName" SelectedValuePath="Value" Style="{StaticResource UpdateChannelComboBoxStyle}"/>
                    </Grid>
                    <Border Height="1" Background="#1E4357" Margin="0,2"/>
                    <Grid Style="{StaticResource HubSettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource HubFieldLabel}" Text="Менеджер версій локалізації"/>
                            <TextBlock Style="{StaticResource HubFieldDesc}" Text="Вибір конкретної версії перекладу."/>
                        </StackPanel>
                        <Button x:Name="UpdateHistoryButton" Grid.Column="1" Style="{StaticResource HubSecondaryButton}" Content="Відкрити…" Height="32"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ============ ОБСЛУГОВУВАННЯ ============ -->
            <Border Style="{StaticResource HubGroupCard}">
                <StackPanel Orientation="Vertical">
                    <TextBlock Style="{StaticResource HubGroupLabel}" Text="ОБСЛУГОВУВАННЯ"/>
                    <Grid Style="{StaticResource HubSettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource HubFieldLabel}" Text="Очистити кеш гри"/>
                            <TextBlock Style="{StaticResource HubFieldDesc}" Text="Видаляє тимчасові файли Star Citizen. Налаштування SCLOC-Verse не зітруться."/>
                        </StackPanel>
                        <Button x:Name="BtnResetCash" Grid.Column="1" Style="{StaticResource HubSecondaryButton}" Content="Очистити…" Height="32"/>
                    </Grid>
                    <Border Height="1" Background="#1E4357" Margin="0,2"/>
                    <Grid Style="{StaticResource HubSettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource HubFieldLabel}" Text="Розширена діагностика"/>
                            <TextBlock Style="{StaticResource HubFieldDesc}" Text="Детальні логи лише під час проблем. За замовчуванням вимкнено."/>
                        </StackPanel>
                        <CheckBox x:Name="AdvancedDiagnosticsCheckBox" Grid.Column="1" Style="{StaticResource HubToggle}" ToolTip="Надсилати додаткову діагностичну інформацію лише під час виникнення проблем."/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- README прихований (не входить у концепцію центру керування; фасад збережено для Zero Regression) -->
            <TextBox x:Name="TxtReadme" Visibility="Collapsed" Width="0" Height="0"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
