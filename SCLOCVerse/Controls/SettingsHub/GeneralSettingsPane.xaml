<UserControl x:Class="SCLOCVerse.Controls.SettingsHub.GeneralSettingsPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SCLOCVerse;component/Resources/Styles.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/SCLOCVerse;component/Resources/SettingsHubKit.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Локальні стилі path-кнопок (поведінка Автопошук/Скинути керується MainWindow) -->
            <SolidColorBrush x:Key="BtnFill"        Color="#30546E"/>
            <SolidColorBrush x:Key="BtnFillHover"   Color="#3A6682"/>
            <SolidColorBrush x:Key="BtnStroke"      Color="#8DD0FF"/>
            <SolidColorBrush x:Key="AutoFill"       Color="#1A5474"/>
            <SolidColorBrush x:Key="AutoFillHover"  Color="#2478A9"/>
            <SolidColorBrush x:Key="ResetFill"      Color="#7E2D2D"/>
            <SolidColorBrush x:Key="ResetFillHover" Color="#933838"/>

            <Style x:Key="ActionButton" TargetType="{x:Type Button}">
                <Setter Property="Height" Value="34"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="Bd" CornerRadius="7" BorderBrush="#4AA3D8" BorderThickness="1">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#3492D8" Offset="0"/>
                                        <GradientStop Color="#1F5F86" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="2" Direction="270" Opacity="0.4"/>
                                </Border.Effect>
                                <Grid>
                                    <Border CornerRadius="6,6,0,0" Height="1" VerticalAlignment="Top" Background="#9ECAEE" Opacity="0.6" Margin="2,1,2,0"/>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#8DD0FF"/>
                                    <Setter TargetName="Bd" Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#46A6E8" Offset="0"/>
                                                <GradientStop Color="#267AA8" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#1F5F86" Offset="0"/>
                                                <GradientStop Color="#164A68" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="AutoSearchButton" TargetType="{x:Type Button}">
                <Setter Property="Height" Value="34"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="Bd" CornerRadius="7" BorderBrush="#8DD0FF" BorderThickness="1">
                                <!-- Типово (Автопошук) — яскравий primary-градієнт -->
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#3FA0E4" Offset="0"/>
                                        <GradientStop Color="#1F6694" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="2" Direction="270" Opacity="0.4"/>
                                </Border.Effect>
                                <Grid>
                                    <Border CornerRadius="6,6,0,0" Height="1" VerticalAlignment="Top" Background="#C9E6F7" Opacity="0.7" Margin="2,1,2,0"/>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Content" Value="Скинути">
                                    <!-- P1: скидання шляху — нейтральне сіре, не небезпечне -->
                                    <Setter Property="FontWeight" Value="Normal"/>
                                    <Setter Property="Foreground" Value="#9DB8C8"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#3A4A56"/>
                                    <Setter TargetName="Bd" Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#44545F" Offset="0"/>
                                                <GradientStop Color="#33414B" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#8DD0FF"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="#000000" BlurRadius="3" ShadowDepth="1" Direction="270" Opacity="0.3"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Рядок налаштування: назва+опис ліворуч, контрол у правій колонці (P4) -->
            <Style x:Key="HubSettingRow" TargetType="Grid">
                <Setter Property="MinHeight" Value="48"/>
                <Setter Property="Margin" Value="0,2"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
        <StackPanel Orientation="Vertical" Margin="0,0,0,16">

            <!-- Cat-head -->
            <StackPanel Orientation="Horizontal" Margin="2,0,0,4">
                <TextBlock Text="ЗАГАЛЬНЕ" FontFamily="Segoe UI" FontSize="15" FontWeight="Bold" Foreground="#EAF4FF"/>
                <TextBlock x:Name="SubtitleText" Margin="12,0,0,0" FontFamily="Segoe UI" FontSize="11.5" Foreground="#5A7A8A" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Style="{StaticResource HubHelpText}" Text="Стан гри, запуск, оновлення та обслуговування."/>

            <!-- ============ STAR CITIZEN ============ -->
            <Border Style="{StaticResource HubGroupCard}">
                <StackPanel Orientation="Vertical">
                    <TextBlock Style="{StaticResource HubGroupLabel}" Text="STAR CITIZEN"/>

                    <!-- Заголовок поля + бейджі середовищ в одному рядку (висота картки стала) -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource HubFieldLabel}" Text="Шлях до папки гри"/>
                            <TextBlock Style="{StaticResource HubFieldDesc}" Text="Використовується для встановлення локалізації та конфігурації."/>
                        </StackPanel>
                        <StackPanel x:Name="EnvBadgesPanel" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,3,0,0"/>
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Height="34" CornerRadius="6" BorderBrush="#2A5A78" BorderThickness="1" Background="#0A1D29" Margin="0,0,8,0">
                            <TextBox x:Name="TxtSelectedPath" FontFamily="Segoe UI Semibold" FontSize="13" Foreground="#A7C6E7"
                                     Background="Transparent" BorderThickness="0" Padding="12,0" IsReadOnly="True"
                                     HorizontalContentAlignment="Left" VerticalContentAlignment="Center"/>
                        </Border>
                        <Button x:Name="BtnSelectFolder" Grid.Column="1" Style="{StaticResource HubSecondaryButton}" Content="Огляд…" Width="100" Margin="0,0,8,0"/>
                        <Button x:Name="BtnAutoSearch" Grid.Column="2" Style="{StaticResource AutoSearchButton}" Content="Автопошук" Width="118"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ============ ЗАПУСК ============ -->
            <Border Style="{StaticResource HubGroupCard}">
                <StackPanel Orientation="Vertical">
                    <TextBlock Style="{StaticResource HubGroupLabel}" Text="ЗАПУСК"/>
                    <Grid Style="{StaticResource HubSettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource HubFieldLabel}" Text="Автозапуск із Windows"/>
                            <TextBlock Style="{StaticResource HubFieldDesc}" Text="Запускати SCLOC-Verse після входу до системи."/>
                        </StackPanel>
                        <CheckBox x:Name="RunAtStartupCheckBox" Grid.Column="1" Style="{StaticResource HubToggle}" ToolTip="Автозапуск синхронізується з реєстром Windows."/>
                    </Grid>
                    <Border Height="1" Background="#1E4357" Margin="0,2"/>
                    <Grid Style="{StaticResource HubSettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource HubFieldLabel}" Text="Згортати в трей при закритті"/>
                            <TextBlock Style="{StaticResource HubFieldDesc}" Text="Замість виходу — іконка в системному лотку."/>
                        </StackPanel>
                        <CheckBox x:Name="MinimizeToTrayCheckBox" Grid.Column="1" Style="{StaticResource HubToggle}" ToolTip="При закритті вікна програма залишиться у системному треї."/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ============ ОНОВЛЕННЯ ============ -->
            <Border Style="{StaticResource HubGroupCard}">
                <StackPanel Orientation="Vertical">
                    <TextBlock Style="{StaticResource HubGroupLabel}" Text="ОНОВЛЕННЯ"/>
                    <Grid Style="{StaticResource HubSettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource HubFieldLabel}" Text="Автооновлення локалізації"/>
                            <TextBlock Style="{StaticResource HubFieldDesc}" Text="Перевіряти та встановлювати оновлення перекладу перед запуском гри."/>
                        </StackPanel>
                        <CheckBox x:Name="AutoUpdateLocalizationCheckBox" Grid.Column="1" Style="{StaticResource HubToggle}" ToolTip="Автоматично перевіряти та встановлювати нові версії локалізації."/>
                    </Grid>
                    <Border Height="1" Background="#1E4357" Margin="0,2"/>
                    <Grid Style="{StaticResource HubSettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource HubFieldLabel}" Text="Канал оновлень"/>
                            <TextBlock Style="{StaticResource HubFieldDesc}" Text="Які збірки застосунку пропонувати при перевірці нової версії."/>
                        </StackPanel>
                        <ComboBox x:Name="UpdateChannelComboBox" Grid.Column="1" Width="150" DisplayMemberPath="DisplayName" SelectedValuePath="Value" Style="{StaticResource HubComboBox}"/>
                    </Grid>
                    <Border Height="1" Background="#1E4357" Margin="0,2"/>
                    <Grid Style="{StaticResource HubSettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource HubFieldLabel}" Text="Менеджер версій локалізації"/>
                            <TextBlock Style="{StaticResource HubFieldDesc}" Text="Вибір конкретної версії перекладу."/>
                        </StackPanel>
                        <Button x:Name="UpdateHistoryButton" Grid.Column="1" Style="{StaticResource HubSecondaryButton}" Content="Відкрити…" Width="110"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ============ ОБСЛУГОВУВАННЯ ============ -->
            <Border Style="{StaticResource HubGroupCard}">
                <StackPanel Orientation="Vertical">
                    <TextBlock Style="{StaticResource HubGroupLabel}" Text="ОБСЛУГОВУВАННЯ"/>
                    <Grid Style="{StaticResource HubSettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource HubFieldLabel}" Text="Очистити кеш гри"/>
                            <TextBlock Style="{StaticResource HubFieldDesc}" Text="Видаляє тимчасові файли Star Citizen. Налаштування SCLOC-Verse не зітруться."/>
                        </StackPanel>
                        <Button x:Name="BtnResetCash" Grid.Column="1" Style="{StaticResource HubSecondaryButton}" Content="Очистити…" Width="110"/>
                    </Grid>
                    <Border Height="1" Background="#1E4357" Margin="0,2"/>
                    <Grid Style="{StaticResource HubSettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource HubFieldLabel}" Text="Розширена діагностика"/>
                            <TextBlock Style="{StaticResource HubFieldDesc}" Text="Детальні логи лише під час проблем. За замовчуванням вимкнено."/>
                        </StackPanel>
                        <CheckBox x:Name="AdvancedDiagnosticsCheckBox" Grid.Column="1" Style="{StaticResource HubToggle}" ToolTip="Надсилати додаткову діагностичну інформацію лише під час виникнення проблем."/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- README прихований (не входить у концепцію центру керування; фасад збережено для Zero Regression) -->
            <TextBox x:Name="TxtReadme" Visibility="Collapsed" Width="0" Height="0"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
