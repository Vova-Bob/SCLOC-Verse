<UserControl x:Class="SCLOCVerse.Controls.SettingsHub.OverlaySettingsPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Unloaded="OverlaySettingsPane_Unloaded">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SCLOCVerse;component/Resources/SettingsHubKit.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Слайдер (P0 — єдина мова) -->
            <Style x:Key="HubSlider" TargetType="Slider">
                <Setter Property="Foreground" Value="#4AA3D8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Border Background="#0F2030" BorderBrush="#1E4357" BorderThickness="1" CornerRadius="4" Padding="2">
                                <!-- Напрямок за замовчуванням: більше значення → правіше (IsDirectionReversed=False) -->
                                <Track Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <!-- Заповнена частина (ліворуч від thumb): приглушена, не неонова -->
                                        <RepeatButton Command="Slider.DecreaseLarge">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Background="#2D5E7E"/>
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <!-- Порожній трек: темний, без hover-chrome -->
                                        <RepeatButton Command="Slider.IncreaseLarge">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Background="#0F2030"/>
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border x:Name="ThumbBd" CornerRadius="5" BorderBrush="#4AA3D8" BorderThickness="1" Width="14" Height="20">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                <GradientStop Color="#B0E2FF" Offset="0"/>
                                                                <GradientStop Color="#6FBCE8" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                        <Border.Effect>
                                                            <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.3"/>
                                                        </Border.Effect>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ThumbBd" Property="BorderBrush" Value="#8DD0FF"/>
                                                            <Setter TargetName="ThumbBd" Property="Background">
                                                                <Setter.Value>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                        <GradientStop Color="#C6ECFF" Offset="0"/>
                                                                        <GradientStop Color="#82CCEE" Offset="1"/>
                                                                    </LinearGradientBrush>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PosBox" TargetType="TextBox">
                <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="#A7C6E7"/>
                <Setter Property="Background" Value="#0A1D29"/>
                <Setter Property="BorderBrush" Value="#2A5A78"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Padding" Value="8,0"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
        <StackPanel Orientation="Vertical" Margin="0,0,0,16">

            <!-- Cat-head -->
            <StackPanel Orientation="Horizontal" Margin="2,0,0,4">
                <TextBlock Text="НАКЛАДАННЯ" FontFamily="Segoe UI" FontSize="15" FontWeight="Bold" Foreground="#EAF4FF"/>
                <TextBlock Text="тип інтерфейсу · 1 активний" Margin="12,0,0,0" FontFamily="Segoe UI" FontSize="11.5" Foreground="#5A7A8A" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Style="{StaticResource HubHelpText}" Text="Спільні налаштування накладань. Швидкі зміни — гарячими клавішами на накладанні; точні — тут."/>

            <!-- ============ HANGAR TIMER (активний) ============ -->
            <Border Style="{StaticResource HubGroupCard}">
                <StackPanel Orientation="Vertical">
                    <!-- Заголовок-смужка зі статус-крапкою (P0 — стан видимий) -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Ellipse Width="9" Height="9" Fill="#5BC98A" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Hangar Timer" FontFamily="Segoe UI Semibold" FontSize="13.5" Foreground="#EAF4FF" VerticalAlignment="Center"/>
                        <TextBlock Text="· активний" FontFamily="Segoe UI" FontSize="11" Foreground="#5A7A8A" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>

                    <!-- Режим відображення (combo рядок) -->
                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource HubFieldLabel}" Text="Вигляд"/>
                            <TextBlock Style="{StaticResource HubFieldDesc}" Text="класичний / спрощений"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" x:Name="HangarModeBox" Style="{StaticResource HubComboBox}" VerticalAlignment="Center" Margin="0,0,0,0">
                            <ComboBoxItem Content="Класичний" Tag="Classic"/>
                            <ComboBoxItem Content="Спрощений" Tag="Simplified"/>
                        </ComboBox>
                    </Grid>

                    <!-- Масштаб -->
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="56"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource HubFieldLabel}" Text="Масштаб"/>
                            <TextBlock Style="{StaticResource HubFieldDesc}" Text="за замовч. 0.60"/>
                        </StackPanel>
                        <Slider Grid.Column="1" x:Name="ScaleSlider" Style="{StaticResource HubSlider}" Minimum="0.2" Maximum="2.0" VerticalAlignment="Center" Margin="10,0,10,0"/>
                        <TextBlock Grid.Column="2" x:Name="ScaleValue" FontFamily="Consolas" FontSize="13" FontWeight="SemiBold" Foreground="#C9DEEF" TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Прозорість -->
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="56"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource HubFieldLabel}" Text="Прозорість"/>
                            <TextBlock Style="{StaticResource HubFieldDesc}" Text="за замовч. 0.92"/>
                        </StackPanel>
                        <Slider Grid.Column="1" x:Name="OpacitySlider" Style="{StaticResource HubSlider}" Minimum="0.2" Maximum="1.0" VerticalAlignment="Center" Margin="10,0,10,0"/>
                        <TextBlock Grid.Column="2" x:Name="OpacityValue" FontFamily="Consolas" FontSize="13" FontWeight="SemiBold" Foreground="#C9DEEF" TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Позиція (службова) -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource HubFieldLabel}" Text="Позиція"/>
                            <TextBlock Style="{StaticResource HubFieldDesc}" Text="службова · у пікселях"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock Text="X" Style="{StaticResource HubFieldLabel}" Margin="0,0,6,0" Foreground="#6F8CA8"/>
                            <TextBox x:Name="PosXBox" Style="{StaticResource PosBox}" Width="80" Height="28"/>
                            <TextBlock Text="Y" Style="{StaticResource HubFieldLabel}" Margin="16,0,6,0" Foreground="#6F8CA8"/>
                            <TextBox x:Name="PosYBox" Style="{StaticResource PosBox}" Width="80" Height="28"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ============ ANTI-AFK (активний) ============ -->
            <Border Style="{StaticResource HubGroupCard}">
                <StackPanel Orientation="Vertical">
                    <!-- Заголовок-смужка зі статус-крапкою -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Ellipse x:Name="AntiAfkStatusDot" Width="9" Height="9" Fill="#44505A" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Anti-AFK" FontFamily="Segoe UI Semibold" FontSize="13.5" Foreground="#EAF4FF" VerticalAlignment="Center"/>
                        <TextBlock x:Name="AntiAfkStatusText" Text="· вимкнено" FontFamily="Segoe UI" FontSize="11" Foreground="#5A7A8A" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>

                    <!-- Стан (toggle рядок) -->
                    <Grid Margin="0,2,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource HubFieldLabel}" Text="Стан"/>
                            <TextBlock Style="{StaticResource HubFieldDesc}" Text="гаряча клавіша — End"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="AntiAfkEnabledToggle" Style="{StaticResource HubToggle}" Content="Увімкнути Anti-AFK" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Колір індикатора (combo рядок) -->
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource HubFieldLabel}" Text="Колір індикатора"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" x:Name="AntiAfkColorBox" Style="{StaticResource HubComboBox}" VerticalAlignment="Center" Margin="0,0,0,0">
                            <ComboBoxItem Content="Приховати" Tag="Hidden"/>
                            <ComboBoxItem Content="Зелений" Tag="#4CAF50"/>
                            <ComboBoxItem Content="Синій" Tag="#42A5F5"/>
                            <ComboBoxItem Content="Жовтий" Tag="#FFEE58"/>
                            <ComboBoxItem Content="Червоний" Tag="#EF5350"/>
                        </ComboBox>
                    </Grid>

                    <!-- Позиція (combo рядок) -->
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource HubFieldLabel}" Text="Позиція"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" x:Name="AntiAfkPositionBox" Style="{StaticResource HubComboBox}" VerticalAlignment="Center" Margin="0,0,0,0">
                            <ComboBoxItem Content="Лівий верхній кут" Tag="TopLeft"/>
                            <ComboBoxItem Content="Правий верхній кут" Tag="TopRight"/>
                            <ComboBoxItem Content="Лівий нижній кут" Tag="BottomLeft"/>
                            <ComboBoxItem Content="Правий нижній кут" Tag="BottomRight"/>
                            <ComboBoxItem Content="По центру" Tag="Center"/>
                        </ComboBox>
                    </Grid>

                    <!-- Розмір (slider рядок) -->
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="56"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource HubFieldLabel}" Text="Розмір"/>
                            <TextBlock Style="{StaticResource HubFieldDesc}" Text="8–32 px"/>
                        </StackPanel>
                        <Slider Grid.Column="1" x:Name="AntiAfkSizeSlider" Style="{StaticResource HubSlider}" Minimum="8" Maximum="32" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="10,0,10,0"/>
                        <TextBlock Grid.Column="2" x:Name="AntiAfkSizeValue" FontFamily="Consolas" FontSize="13" FontWeight="SemiBold" Foreground="#C9DEEF" TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Анімація (combo рядок) -->
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource HubFieldLabel}" Text="Анімація"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" x:Name="AntiAfkAnimationBox" Style="{StaticResource HubComboBox}" VerticalAlignment="Center" Margin="0,0,0,0">
                            <ComboBoxItem Content="Пульсація" Tag="Pulse"/>
                            <ComboBoxItem Content="Плавна пульсація" Tag="Breathing"/>
                        </ComboBox>
                    </Grid>

                    <!-- Режим (combo рядок) -->
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource HubFieldLabel}" Text="Режим"/>
                            <TextBlock Style="{StaticResource HubFieldDesc}" Text="постійно / під час спрацювання"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" x:Name="AntiAfkModeBox" Style="{StaticResource HubComboBox}" VerticalAlignment="Center" Margin="0,0,0,0">
                            <ComboBoxItem Content="Постійно" Tag="Running"/>
                            <ComboBoxItem Content="Лише під час спрацювання" Tag="IdleOnly"/>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ============ AUTO KEY (активний) ============ -->
            <Border Style="{StaticResource HubGroupCard}">
                <StackPanel Orientation="Vertical">
                    <!-- Заголовок-смужка зі статус-крапкою -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Ellipse x:Name="AutoKeyStatusDot" Width="9" Height="9" Fill="#44505A" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Auto Key" FontFamily="Segoe UI Semibold" FontSize="13.5" Foreground="#EAF4FF" VerticalAlignment="Center"/>
                        <TextBlock x:Name="AutoKeyStatusText" Text="· вимкнено" FontFamily="Segoe UI" FontSize="11" Foreground="#5A7A8A" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>

                    <!-- Перемикач (toggle рядок) -->
                    <Grid Margin="0,2,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource HubFieldLabel}" Text="Перемикач"/>
                            <TextBlock Style="{StaticResource HubFieldDesc}" Text="гаряча клавіша — Home"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="AutoKeyEnabledToggle" Style="{StaticResource HubToggle}" Content="Увімкнути Auto Key" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Клавіша дії (Action Key) -->
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource HubFieldLabel}" Text="Клавіша дії"/>
                            <TextBlock Style="{StaticResource HubFieldDesc}" Text="натискається автоматично"/>
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="AutoKeyActionKeyKeycap" Style="{StaticResource HubKeycap}" Content="[" HorizontalAlignment="Left" Width="120" ToolTip="Клікніть, щоб змінити"/>
                    </Grid>

                    <!-- Інтервал (slider рядок) -->
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="64"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource HubFieldLabel}" Text="Інтервал"/>
                            <TextBlock Style="{StaticResource HubFieldDesc}" Text="100–2000 мс"/>
                        </StackPanel>
                        <Slider Grid.Column="1" x:Name="AutoKeyIntervalSlider" Style="{StaticResource HubSlider}" Minimum="100" Maximum="2000" TickFrequency="50" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="10,0,10,0"/>
                        <TextBlock Grid.Column="2" x:Name="AutoKeyIntervalValue" FontFamily="Consolas" FontSize="13" FontWeight="SemiBold" Foreground="#C9DEEF" TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Підказка про гарячі клавіші (kbd-бейджі) -->
            <StackPanel Orientation="Horizontal" Margin="4,2,0,0">
                <TextBlock Text="Швидкі зміни:" FontFamily="Segoe UI" FontSize="11" Foreground="#6F8CA8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Border Style="{StaticResource HubKbdBadge}"><TextBlock Text="Ctrl ±" FontFamily="Segoe UI Semibold" FontSize="11" Foreground="#8DD0FF"/></Border>
                <TextBlock Text="масштаб" FontFamily="Segoe UI" FontSize="11" Foreground="#6F8CA8" VerticalAlignment="Center" Margin="6,0,12,0"/>
                <Border Style="{StaticResource HubKbdBadge}"><TextBlock Text="Ctrl+Alt ±" FontFamily="Segoe UI Semibold" FontSize="11" Foreground="#8DD0FF"/></Border>
                <TextBlock Text="прозорість — на активному накладанні" FontFamily="Segoe UI" FontSize="11" Foreground="#6F8CA8" VerticalAlignment="Center" Margin="6,0,0,0"/>
            </StackPanel>

            <!-- Зміни застосовуються негайно (накладання відкрите) або при наступному показі -->
            <TextBlock Style="{StaticResource HubFieldDesc}" Margin="4,10,0,0" Text="Зміни масштабу й прозорості застосовуються негайно, якщо накладання відкрите."/>

            <!-- Reset усіх накладань (P1 — Secondary Button, чітко видима) -->
            <Button x:Name="ResetButton" Style="{StaticResource HubSecondaryButton}" Content="↺ Скинути всі накладання" HorizontalAlignment="Left" Margin="0,14,0,0"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
