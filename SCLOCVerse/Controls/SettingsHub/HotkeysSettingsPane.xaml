<UserControl x:Class="SCLOCVerse.Controls.SettingsHub.HotkeysSettingsPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SCLOCVerse;component/Resources/SettingsHubKit.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
        <StackPanel Orientation="Vertical" Margin="0,0,0,16">

            <!-- Cat-head -->
            <StackPanel Orientation="Horizontal" Margin="2,0,0,4">
                <TextBlock Text="ГАРЯЧІ КЛАВІШІ" FontFamily="Segoe UI" FontSize="15" FontWeight="Bold" Foreground="#EAF4FF"/>
                <TextBlock x:Name="CountText" Margin="12,0,0,0" FontFamily="Segoe UI" FontSize="11.5" Foreground="#5A7A8A" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Style="{StaticResource HubHelpText}" Text="Перелік активних комбінацій. Працюють глобально, навіть коли гра на весь екран."/>

            <!-- Опис стану (read-only, без редагування — P5) — компактний -->
            <Border Background="#0E2A1C" BorderBrush="#2E6B45" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="ℹ" FontSize="13" Foreground="#7FA84A" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock FontFamily="Segoe UI" FontSize="12" Foreground="#A7C6E7" VerticalAlignment="Center">
                        <Run Text="Перелік активних комбінацій. "/>
                        <Run Text="Редагування з'явиться в наступній версії." FontWeight="SemiBold" Foreground="#C9E0A0"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Динамічно збудований список груп/рядків -->
            <StackPanel x:Name="HotkeyList" Orientation="Vertical"/>

            <!-- Reset категорії — disabled (редактор гарячих клавіш — Phase 0.5).
                 Присутнє місце сигналізує про майбутню дію, без fake-функціоналу (P5). -->
            <Button Style="{StaticResource HubSecondaryButton}" Content="↺ За замовчуванням"
                    HorizontalAlignment="Left" Margin="0,14,0,0" IsEnabled="False"
                    ToolTip="Скидання комбінацій стане доступним разом із редактором гарячих клавіш (наступна версія)."/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
