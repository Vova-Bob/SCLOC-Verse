<UserControl x:Class="SCLOCVerse.Controls.SettingsHub.HotkeysSettingsPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SCLOCVerse;component/Resources/SettingsHubKit.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
        <StackPanel Orientation="Vertical" Margin="0,0,0,16">

            <!-- Cat-head -->
            <StackPanel Orientation="Horizontal" Margin="2,0,0,4">
                <TextBlock Text="ГАРЯЧІ КЛАВІШІ" FontFamily="Segoe UI" FontSize="15" FontWeight="Bold" Foreground="#EAF4FF"/>
                <TextBlock x:Name="CountText" Margin="12,0,0,0" FontFamily="Segoe UI" FontSize="11.5" Foreground="#5A7A8A" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Style="{StaticResource HubHelpText}" Text="Натисніть на комбінацію, щоб змінити її. Працюють глобально, навіть коли гра на весь екран."/>

            <!-- Динамічно збудований список груп/рядків -->
            <StackPanel x:Name="HotkeyList" Orientation="Vertical"/>

            <!-- Footer: інструкція + reset-категорія -->
            <StackPanel Orientation="Horizontal" Margin="2,10,0,0">
                <Border Style="{StaticResource HubKbdBadge}"><TextBlock Text="Esc" FontFamily="Segoe UI Semibold" FontSize="10.5" Foreground="#8DD0FF"/></Border>
                <TextBlock Text="скасовує введення" FontFamily="Segoe UI" FontSize="11" Foreground="#6F8CA8" VerticalAlignment="Center" Margin="6,0,24,0"/>
                <Border Style="{StaticResource HubKbdBadge}"><TextBlock Text="Backspace" FontFamily="Segoe UI Semibold" FontSize="10.5" Foreground="#8DD0FF"/></Border>
                <TextBlock Text="те саме" FontFamily="Segoe UI" FontSize="11" Foreground="#6F8CA8" VerticalAlignment="Center" Margin="6,0,0,0"/>
            </StackPanel>

            <Button x:Name="CategoryResetButton" Style="{StaticResource HubSecondaryButton}" Content="↺ Скинути всі гарячі клавіші"
                    HorizontalAlignment="Left" Margin="0,14,0,0" Click="CategoryReset_Click"
                    ToolTip="Скинути всі комбінації до типових. Лише ця категорія."/>

        </StackPanel>
    </ScrollViewer>
</UserControl>