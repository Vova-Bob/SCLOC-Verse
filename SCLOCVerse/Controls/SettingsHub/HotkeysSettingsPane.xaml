<UserControl x:Class="SCLOCVerse.Controls.SettingsHub.HotkeysSettingsPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>
        <ResourceDictionary>
            <!-- Бейдж жесту: статичний, не інтерактивний (read-only). -->
            <Style x:Key="GestureBadge" TargetType="Border">
                <Setter Property="Background" Value="#102A3A"/>
                <Setter Property="BorderBrush" Value="#2478A9"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="5"/>
                <Setter Property="Padding" Value="12,5"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
        <StackPanel Orientation="Vertical" Margin="0,0,0,16">

            <!-- Заголовок категорії + лічильник -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="ГАРЯЧІ КЛАВІШІ" FontFamily="Segoe UI" FontSize="15" FontWeight="SemiBold" Foreground="#8DD0FF"/>
                <TextBlock x:Name="CountText" Margin="12,0,0,0" FontFamily="Segoe UI" FontSize="13" Foreground="#6F8CA8" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Опис стану (read-only, без редагування) -->
            <Border Background="#16122914" BorderBrush="#3A5A1E" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="ℹ" FontSize="18" Foreground="#7FA84A" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock FontFamily="Segoe UI" FontSize="13" Foreground="#A7C6E7" TextWrapping="Wrap" MaxWidth="640">
                        <Run Text="Це перелік активних комбінацій. "/>
                        <Run Text="Редагування з'явиться в наступній версії." FontWeight="SemiBold" Foreground="#C9E0A0"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Динамічно збудований список груп/рядків -->
            <StackPanel x:Name="HotkeyList" Orientation="Vertical"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
