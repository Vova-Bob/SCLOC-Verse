<Canvas x:Class="SCLOCVerse.Controls.LocalizationCanvas"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SCLOCVerse.Controls"
        Background="Transparent">

    <!-- ===== РЕСУРСИ ДЛЯ КНОПОК ===== -->
    <Canvas.Resources>
        <!-- Базові кольори -->
        <SolidColorBrush x:Key="BtnFill"        Color="#30546E"/>
        <SolidColorBrush x:Key="BtnFillHover"   Color="#3A6682"/>
        <SolidColorBrush x:Key="BtnStroke"      Color="#8DD0FF"/>
        <SolidColorBrush x:Key="BtnShadow"      Color="#000000"/>

        <!-- Спільний стиль дійової кнопки з рамкою і анімацією натискання -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Width" Value="150"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Background" Value="{StaticResource BtnFill}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- Весь контент у корені для анімації Scale -->
                        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <!-- масштабуємо весь Grid при натисканні -->
                                <ScaleTransform x:Name="PressScale" ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>

                            <!-- Тінь під кнопкою -->
                            <Grid.Effect>
                                <DropShadowEffect Color="{Binding Color, Source={StaticResource BtnShadow}}"
                                                  BlurRadius="12"
                                                  ShadowDepth="6"
                                                  Opacity="0.45"/>
                            </Grid.Effect>

                            <!-- ФОН та Геометрія кнопок-->
                            <Path x:Name="BtnBg"
                                  Fill="{TemplateBinding Background}"
                                  Stretch="Fill" SnapsToDevicePixels="True"
                                  Data="M 5,0 L 95,0 A 6,6 0 0 1 100,6 L 100,30 L 95,40 L 5,40 A 6,6 0 0 1 0,34 L 0,10 Z"/>

                            <!-- РАМКА -->
                            <Path x:Name="BtnStroke"
                                  Stroke="{StaticResource BtnStroke}"
                                  StrokeThickness="1"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Fill="Transparent"
                                  Stretch="Fill" SnapsToDevicePixels="True"
                                  Data="M 5,0 L 95,0 A 5.5,5.5 0 0 1 100,5.5 L 100,30 L 95,40 L 5,40 A 5.5,5.5 0 0 1 0,34.5 L 0,10 Z"/>

                            <!-- Текст -->
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Grid>

                        <!-- ТРИГЕРИ СТАНІВ -->
                        <ControlTemplate.Triggers>
                            <!-- Наведення: легке підсвічення -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBg" Property="Fill" Value="{StaticResource BtnFillHover}"/>
                                <Setter TargetName="BtnStroke" Property="StrokeThickness" Value="2.6"/>
                            </Trigger>

                            <!-- Натиснення: м’яке стискання з анімацією -->
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <!-- стискаємо до 0.97 -->
                                            <DoubleAnimation Storyboard.TargetName="PressScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="0.97" Duration="0:0:0.06" />
                                            <DoubleAnimation Storyboard.TargetName="PressScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="0.97" Duration="0:0:0.06" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <!-- повертаємо 1.00 -->
                                            <DoubleAnimation Storyboard.TargetName="PressScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.08" />
                                            <DoubleAnimation Storyboard.TargetName="PressScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.08" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <!-- Вимкнено -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Canvas.Resources>

    <!-- Заголовок секції -->
    <Grid Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Canvas}}">
        <TextBlock Text="Встановлення локалізації"
                   FontFamily="Arial"
                   Foreground="White"
                   FontSize="20"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,20,0,0"/>
    </Grid>

    <!-- Селектор середовища -->
    <controls:EnvironmentSelector x:Name="EnvSelector"
                                  Canvas.Left="475"
                                  Canvas.Top="60"/>

    <!-- Кнопка повернення на головну -->
    <Button x:Name="BtnReturnHome"
            Canvas.Top="240" Canvas.Left="0"
            Width="50" Height="100"
            Background="Transparent"
            Cursor="Hand" HorizontalAlignment="Left" VerticalAlignment="Center">
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="IdleScale" ScaleX="1" ScaleY="1"/>
                    </Grid.RenderTransform>

                    <Rectangle Fill="Transparent" Width="50" Height="100"/>

                    <Border x:Name="GlowHost"
                            Width="50" Height="100"
                            Background="Transparent"
                            Opacity="0.28"
                            CornerRadius="25">
                        <Border.Effect>
                            <DropShadowEffect Color="#6DB9F8"
                                              BlurRadius="22"
                                              ShadowDepth="0"
                                              Opacity="0.55"/>
                        </Border.Effect>
                    </Border>

                    <Path x:Name="ArrowPath2"
                          Data="M22,5 L12,22 L22,39"
                          Stroke="#6DB9F8"
                          StrokeThickness="4.5"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                        <Path.Effect>
                            <DropShadowEffect Color="#6DB9F8"
                                              BlurRadius="10"
                                              ShadowDepth="0"
                                              Opacity="0.85"/>
                        </Path.Effect>
                    </Path>
                </Grid>

                <ControlTemplate.Resources>
                    <Storyboard x:Key="IdleBreathe" RepeatBehavior="Forever" AutoReverse="True">
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="IdleScale" Storyboard.TargetProperty="ScaleX">
                            <EasingDoubleKeyFrame KeyTime="0:0:0" Value="1.00"/>
                            <EasingDoubleKeyFrame KeyTime="0:0:1.25" Value="1.08">
                                <EasingDoubleKeyFrame.EasingFunction>
                                    <SineEase EasingMode="EaseInOut"/>
                                </EasingDoubleKeyFrame.EasingFunction>
                            </EasingDoubleKeyFrame>
                            <EasingDoubleKeyFrame KeyTime="0:0:2.5" Value="1.00">
                                <EasingDoubleKeyFrame.EasingFunction>
                                    <SineEase EasingMode="EaseInOut"/>
                                </EasingDoubleKeyFrame.EasingFunction>
                            </EasingDoubleKeyFrame>
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="IdleScale" Storyboard.TargetProperty="ScaleY">
                            <EasingDoubleKeyFrame KeyTime="0:0:0" Value="1.00"/>
                            <EasingDoubleKeyFrame KeyTime="0:0:1.25" Value="1.08">
                                <EasingDoubleKeyFrame.EasingFunction>
                                    <SineEase EasingMode="EaseInOut"/>
                                </EasingDoubleKeyFrame.EasingFunction>
                            </EasingDoubleKeyFrame>
                            <EasingDoubleKeyFrame KeyTime="0:0:2.5" Value="1.00">
                                <EasingDoubleKeyFrame.EasingFunction>
                                    <SineEase EasingMode="EaseInOut"/>
                                </EasingDoubleKeyFrame.EasingFunction>
                            </EasingDoubleKeyFrame>
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="GlowHost" Storyboard.TargetProperty="Opacity">
                            <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0.22"/>
                            <EasingDoubleKeyFrame KeyTime="0:0:1.25" Value="0.36">
                                <EasingDoubleKeyFrame.EasingFunction>
                                    <SineEase EasingMode="EaseInOut"/>
                                </EasingDoubleKeyFrame.EasingFunction>
                            </EasingDoubleKeyFrame>
                            <EasingDoubleKeyFrame KeyTime="0:0:2.5" Value="0.22">
                                <EasingDoubleKeyFrame.EasingFunction>
                                    <SineEase EasingMode="EaseInOut"/>
                                </EasingDoubleKeyFrame.EasingFunction>
                            </EasingDoubleKeyFrame>
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="GlowHost" Storyboard.TargetProperty="(Effect).(DropShadowEffect.Opacity)">
                            <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0.45"/>
                            <EasingDoubleKeyFrame KeyTime="0:0:1.25" Value="0.75">
                                <EasingDoubleKeyFrame.EasingFunction>
                                    <SineEase EasingMode="EaseInOut"/>
                                </EasingDoubleKeyFrame.EasingFunction>
                            </EasingDoubleKeyFrame>
                            <EasingDoubleKeyFrame KeyTime="0:0:2.5" Value="0.45">
                                <EasingDoubleKeyFrame.EasingFunction>
                                    <SineEase EasingMode="EaseInOut"/>
                                </EasingDoubleKeyFrame.EasingFunction>
                            </EasingDoubleKeyFrame>
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>                </ControlTemplate.Resources>

                <ControlTemplate.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard Storyboard="{StaticResource IdleBreathe}"/>
                    </EventTrigger>

                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="ArrowPath2" Property="Stroke" Value="#8DD0FF"/>
                        <Setter TargetName="ArrowPath2" Property="StrokeThickness" Value="5.2"/>
                        <Setter TargetName="GlowHost" Property="Opacity" Value="0.55"/>
                        <Setter Property="RenderTransform">
                            <Setter.Value>
                                <ScaleTransform ScaleX="1.12" ScaleY="1.12"/>
                            </Setter.Value>
                        </Setter>
                        <Trigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="ArrowPath2"
                                                     Storyboard.TargetProperty="StrokeThickness"
                                                     To="5.2" Duration="0:0:0.18"/>
                                    <DoubleAnimation Storyboard.TargetName="GlowHost"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="0.55" Duration="0:0:0.18"/>
                                    <DoubleAnimation Storyboard.TargetName="GlowHost"
                                                     Storyboard.TargetProperty="(Effect).(DropShadowEffect.Opacity)"
                                                     To="0.95" Duration="0:0:0.18"/>
                                    <DoubleAnimation Storyboard.TargetName="GlowHost"
                                                     Storyboard.TargetProperty="(Effect).(DropShadowEffect.BlurRadius)"
                                                     To="30" Duration="0:0:0.18"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="ArrowPath2"
                                                     Storyboard.TargetProperty="StrokeThickness"
                                                     To="4.5" Duration="0:0:0.25"/>
                                    <DoubleAnimation Storyboard.TargetName="GlowHost"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="0.22" Duration="0:0:0.25"/>
                                    <DoubleAnimation Storyboard.TargetName="GlowHost"
                                                     Storyboard.TargetProperty="(Effect).(DropShadowEffect.Opacity)"
                                                     To="0.45" Duration="0:0:0.25"/>
                                    <DoubleAnimation Storyboard.TargetName="GlowHost"
                                                     Storyboard.TargetProperty="(Effect).(DropShadowEffect.BlurRadius)"
                                                     To="22" Duration="0:0:0.25"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.ExitActions>
                    </Trigger>

                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="RenderTransform">
                            <Setter.Value>
                                <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                            </Setter.Value>
                        </Setter>
                        <Trigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleX)"
                                                     To="0.95" Duration="0:0:0.08"/>
                                    <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleY)"
                                                     To="0.95" Duration="0:0:0.08"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleX)"
                                                     To="1.12" Duration="0:0:0.12"/>
                                    <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleY)"
                                                     To="1.12" Duration="0:0:0.12"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.ExitActions>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Button.Template>
    </Button>

    <!-- КНОПКИ ДІЙ ЗІ СПІЛЬНИМ СТИЛЕМ -->
    <Button x:Name="BtnInstall"
            Style="{StaticResource ActionButton}"
            Content="Встановити"
            Canvas.Left="770"
            Canvas.Top="88"/>

    <Button x:Name="BtnLocalisationDelete"
            Style="{StaticResource ActionButton}"
            Content="Видалити"
            Canvas.Left="770"
            Canvas.Top="150"/>

    <Border Canvas.Left="70" Canvas.Top="220"
     Width="820" Height="270"
     CornerRadius="10"
     BorderBrush="#6DB9F8"
     BorderThickness="1"
     Background="#CC0A1D29">
        <TextBox x:Name="TxtLocalizationReadme"
         FontFamily="Segoe UI Semibold"
         FontSize="16"
         Foreground="#A9C6E2"
         Background="Transparent"
         BorderThickness="0"
         Padding="10,6"
         IsReadOnly="True"
         AcceptsReturn="True"
         TextWrapping="Wrap"            
         HorizontalContentAlignment="Stretch"
         VerticalContentAlignment="Top"
         TextAlignment="Justify"/>

    </Border>

</Canvas>
