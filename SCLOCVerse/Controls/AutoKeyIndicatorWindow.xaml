<Window x:Class="SCLOCVerse.Controls.AutoKeyIndicatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoKeyIndicator"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        ShowActivated="False">

    <Border x:Name="Badge"
            Background="#CC0A1D29"
            BorderBrush="#2A5A78"
            BorderThickness="1"
            CornerRadius="10"
            Padding="8,3">
        <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="Dot" Width="8" Height="8" Fill="#44505A" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBlock x:Name="Label" Text="Auto Key" FontFamily="Segoe UI Semibold" FontSize="10.5" Foreground="#A7C6E7" VerticalAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>
