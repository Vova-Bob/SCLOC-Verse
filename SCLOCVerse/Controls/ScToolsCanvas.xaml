<Canvas x:Class="SCLOCVerse.Controls.ScToolsCanvas"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cv="clr-namespace:SCLOCVerse.Helpers.Converters"
    xmlns:controls="clr-namespace:SCLOCVerse.Controls"
         Background="Transparent">

    <Canvas.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <cv:NullToBooleanConverter x:Key="NullToBoolean"/>
        <cv:ActionToButtonStyleConverter x:Key="ActionToButtonStyleConverter"/>

        <!-- Базові кольори карток -->
        <SolidColorBrush x:Key="CardFill" Color="#1F3C4C"/>
        <SolidColorBrush x:Key="CardFillHover" Color="#385565"/>
        <SolidColorBrush x:Key="CardBorder" Color="#4A90E2"/>
        <SolidColorBrush x:Key="CardShadow" Color="#000000"/>

        <!-- Стиль картки інструменту -->
        <Style x:Key="ToolCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{StaticResource CardFill}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="4" Opacity="0.4"/>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource CardFillHover}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="4" Opacity="0.4"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="IsMouseCaptured" Value="True">
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль кнопки картки інструменту -->
        <Style x:Key="ToolCardButton" TargetType="Button">
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="#30546E"/>
            <Setter Property="BorderBrush" Value="#8DD0FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3A6682"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#274A60"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль неактивної кнопки картки-заповнювача -->
        <Style x:Key="ToolPlaceholderButton" TargetType="Button">
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="#30546E"/>
            <Setter Property="BorderBrush" Value="#8DD0FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="IsEnabled" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Opacity="0.6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Canvas.Resources>

    <!-- Заголовок -->
    <Grid Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Canvas}}"
          HorizontalAlignment="Center">
        <TextBlock Text="Інструменти SC"
                   FontFamily="Arial"
                   Foreground="White"
                   FontSize="22"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,25,0,0"/>
    </Grid>

    <!-- Опис -->
    <TextBlock Canvas.Left="70"
               Canvas.Top="70"
               Foreground="White"
               FontSize="15"
               Opacity="0.85"
               Width="820"
               TextWrapping="Wrap">
        Тут зібрані корисні інструменти спільноти SCLOC-Verse, які допомагають зробити гру у Star Citizen зручнішою.
    </TextBlock>

    <!-- Кнопка повернення на головну -->
    <Button x:Name="BtnReturnHome"
            Canvas.Top="240" Canvas.Left="0"
            Width="50" Height="100"
            Background="Transparent"
            Cursor="Hand" HorizontalAlignment="Left" VerticalAlignment="Center">
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="IdleScale" ScaleX="1" ScaleY="1"/>
                    </Grid.RenderTransform>

                    <Rectangle Fill="Transparent" Width="50" Height="100"/>

                    <Border x:Name="GlowHost"
                            Width="50" Height="100"
                            Background="Transparent"
                            Opacity="0.28"
                            CornerRadius="25">
                        <Border.Effect>
                            <DropShadowEffect Color="#6DB9F8"
                                              BlurRadius="22"
                                              ShadowDepth="0"
                                              Opacity="0.55"/>
                        </Border.Effect>
                    </Border>

                    <Path x:Name="ArrowPath2"
                          Data="M22,5 L12,22 L22,39"
                          Stroke="#6DB9F8"
                          StrokeThickness="4.5"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                        <Path.Effect>
                            <DropShadowEffect Color="#6DB9F8"
                                              BlurRadius="10"
                                              ShadowDepth="0"
                                              Opacity="0.85"/>
                        </Path.Effect>
                    </Path>
                </Grid>

                <ControlTemplate.Resources>
                    <Storyboard x:Key="IdleBreathe" RepeatBehavior="Forever" AutoReverse="True">
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="IdleScale" Storyboard.TargetProperty="ScaleX">
                            <EasingDoubleKeyFrame KeyTime="0:0:0" Value="1.00"/>
                            <EasingDoubleKeyFrame KeyTime="0:0:1.25" Value="1.08">
                                <EasingDoubleKeyFrame.EasingFunction>
                                    <SineEase EasingMode="EaseInOut"/>
                                </EasingDoubleKeyFrame.EasingFunction>
                            </EasingDoubleKeyFrame>
                            <EasingDoubleKeyFrame KeyTime="0:0:2.5" Value="1.00">
                                <EasingDoubleKeyFrame.EasingFunction>
                                    <SineEase EasingMode="EaseInOut"/>
                                </EasingDoubleKeyFrame.EasingFunction>
                            </EasingDoubleKeyFrame>
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="IdleScale" Storyboard.TargetProperty="ScaleY">
                            <EasingDoubleKeyFrame KeyTime="0:0:0" Value="1.00"/>
                            <EasingDoubleKeyFrame KeyTime="0:0:1.25" Value="1.08">
                                <EasingDoubleKeyFrame.EasingFunction>
                                    <SineEase EasingMode="EaseInOut"/>
                                </EasingDoubleKeyFrame.EasingFunction>
                            </EasingDoubleKeyFrame>
                            <EasingDoubleKeyFrame KeyTime="0:0:2.5" Value="1.00">
                                <EasingDoubleKeyFrame.EasingFunction>
                                    <SineEase EasingMode="EaseInOut"/>
                                </EasingDoubleKeyFrame.EasingFunction>
                            </EasingDoubleKeyFrame>
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="GlowHost" Storyboard.TargetProperty="Opacity">
                            <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0.22"/>
                            <EasingDoubleKeyFrame KeyTime="0:0:1.25" Value="0.36">
                                <EasingDoubleKeyFrame.EasingFunction>
                                    <SineEase EasingMode="EaseInOut"/>
                                </EasingDoubleKeyFrame.EasingFunction>
                            </EasingDoubleKeyFrame>
                            <EasingDoubleKeyFrame KeyTime="0:0:2.5" Value="0.22">
                                <EasingDoubleKeyFrame.EasingFunction>
                                    <SineEase EasingMode="EaseInOut"/>
                                </EasingDoubleKeyFrame.EasingFunction>
                            </EasingDoubleKeyFrame>
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="GlowHost" Storyboard.TargetProperty="(Effect).(DropShadowEffect.Opacity)">
                            <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0.45"/>
                            <EasingDoubleKeyFrame KeyTime="0:0:1.25" Value="0.75">
                                <EasingDoubleKeyFrame.EasingFunction>
                                    <SineEase EasingMode="EaseInOut"/>
                                </EasingDoubleKeyFrame.EasingFunction>
                            </EasingDoubleKeyFrame>
                            <EasingDoubleKeyFrame KeyTime="0:0:2.5" Value="0.45">
                                <EasingDoubleKeyFrame.EasingFunction>
                                    <SineEase EasingMode="EaseInOut"/>
                                </EasingDoubleKeyFrame.EasingFunction>
                            </EasingDoubleKeyFrame>
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>                </ControlTemplate.Resources>

                <ControlTemplate.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard Storyboard="{StaticResource IdleBreathe}"/>
                    </EventTrigger>

                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="ArrowPath2" Property="Stroke" Value="#8DD0FF"/>
                        <Setter TargetName="ArrowPath2" Property="StrokeThickness" Value="5.2"/>
                        <Setter TargetName="GlowHost" Property="Opacity" Value="0.55"/>
                        <Setter Property="RenderTransform">
                            <Setter.Value>
                                <ScaleTransform ScaleX="1.12" ScaleY="1.12"/>
                            </Setter.Value>
                        </Setter>
                        <Trigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="ArrowPath2"
                                                     Storyboard.TargetProperty="StrokeThickness"
                                                     To="5.2" Duration="0:0:0.18"/>
                                    <DoubleAnimation Storyboard.TargetName="GlowHost"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="0.55" Duration="0:0:0.18"/>
                                    <DoubleAnimation Storyboard.TargetName="GlowHost"
                                                     Storyboard.TargetProperty="(Effect).(DropShadowEffect.Opacity)"
                                                     To="0.95" Duration="0:0:0.18"/>
                                    <DoubleAnimation Storyboard.TargetName="GlowHost"
                                                     Storyboard.TargetProperty="(Effect).(DropShadowEffect.BlurRadius)"
                                                     To="30" Duration="0:0:0.18"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="ArrowPath2"
                                                     Storyboard.TargetProperty="StrokeThickness"
                                                     To="4.5" Duration="0:0:0.25"/>
                                    <DoubleAnimation Storyboard.TargetName="GlowHost"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="0.22" Duration="0:0:0.25"/>
                                    <DoubleAnimation Storyboard.TargetName="GlowHost"
                                                     Storyboard.TargetProperty="(Effect).(DropShadowEffect.Opacity)"
                                                     To="0.45" Duration="0:0:0.25"/>
                                    <DoubleAnimation Storyboard.TargetName="GlowHost"
                                                     Storyboard.TargetProperty="(Effect).(DropShadowEffect.BlurRadius)"
                                                     To="22" Duration="0:0:0.25"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.ExitActions>
                    </Trigger>

                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="RenderTransform">
                            <Setter.Value>
                                <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                            </Setter.Value>
                        </Setter>
                        <Trigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleX)"
                                                     To="0.95" Duration="0:0:0.08"/>
                                    <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleY)"
                                                     To="0.95" Duration="0:0:0.08"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleX)"
                                                     To="1.12" Duration="0:0:0.12"/>
                                    <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleY)"
                                                     To="1.12" Duration="0:0:0.12"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.ExitActions>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Button.Template>
    </Button>

    <!-- Контейнер для списку інструментів -->
    <ItemsControl x:Name="ToolsList"
                    Canvas.Left="70"
                    Canvas.Top="120"
                    Width="820"
                    Height="370">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal"/>
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>

        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <controls:HangarTimerCard/>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>

</Canvas>
