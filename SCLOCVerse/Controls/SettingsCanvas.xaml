<Canvas x:Class="SCLOCVerse.Controls.SettingsCanvas"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hub="clr-namespace:SCLOCVerse.Controls.SettingsHub"
        Background="Transparent">

    <Canvas.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SCLOCVerse;component/Resources/Styles.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/SCLOCVerse;component/Resources/SettingsHubKit.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Пункт навігації категорії (єдиний стиль; активний стан — з code-behind) -->
            <Style x:Key="HubNavItem" TargetType="{x:Type Button}">
                <Setter Property="Height" Value="36"/>
                <Setter Property="Margin" Value="0,2,0,0"/>
                <Setter Property="Padding" Value="16,0,13,0"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Foreground" Value="#9DBBD4"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize" Value="13.5"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="7">
                                <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#162E42"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Посилання «Головна» (навігація повернення, не категорія) -->
            <Style x:Key="HubHomeLink" TargetType="{x:Type Button}" BasedOn="{StaticResource HubNavItem}">
                <Setter Property="Foreground" Value="#6F8CA8"/>
                <Setter Property="Margin" Value="0"/>
            </Style>
        </ResourceDictionary>
    </Canvas.Resources>

    <!-- Кореневий Grid заповнює Canvas. Сильне затемнення фонового зображення (≈85%):
         фон лишається лише текстурою, картки стають головним візуальним елементом. -->
    <Grid Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type Canvas}}}"
          Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType={x:Type Canvas}}}"
          Background="#D908131C">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ ЗАГОЛОВОК ============ -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,16,20,8">
            <TextBlock Text="НАЛАШТУВАННЯ" FontFamily="Arial" Foreground="#EAF4FF" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock Text="Центр керування застосунком" FontFamily="Segoe UI" Foreground="#4A6A85" FontSize="12" VerticalAlignment="Center" Margin="12,2,0,0"/>
        </StackPanel>

        <!-- ============ ТІЛО: навігація + вміст ============ -->
        <Grid Grid.Row="1" Margin="20,0,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="32"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Ліва панель навігації -->
            <Border Grid.Column="0" Background="#0A1828" BorderBrush="#1E4357" BorderThickness="1,0,1,0" CornerRadius="0">
                <StackPanel x:Name="NavRail" Orientation="Vertical" Margin="6,10">

                    <!-- Головна — навігація повернення (не категорія). Збережено x:Name BtnReturnHome → wire MainWindow лишається. -->
                    <Button x:Name="BtnReturnHome" Style="{StaticResource HubHomeLink}" Content="←  Головна"/>

                    <!-- Роздільник між поверненням і категоріями -->
                    <Border Height="1" Background="#1E4357" Margin="4,8,4,8"/>

                    <Button x:Name="NavGeneral"      Style="{StaticResource HubNavItem}" Content="Загальне"         Tag="{x:Reference PaneGeneral}"    Click="NavButton_Click"/>
                    <Button x:Name="NavLocalization" Style="{StaticResource HubNavItem}" Content="Локалізація"      Tag="{x:Reference PaneLocalization}" Click="NavButton_Click"/>
                    <Button x:Name="NavInterface"   Style="{StaticResource HubNavItem}" Content="Інтерфейс"        Tag="{x:Reference PaneInterface}"  Click="NavButton_Click"/>
                    <Button x:Name="NavHotkeys"     Style="{StaticResource HubNavItem}" Content="Гарячі клавіші"   Tag="{x:Reference PaneHotkeys}"    Click="NavButton_Click"/>
                    <Button x:Name="NavOverlay"     Style="{StaticResource HubNavItem}" Content="Overlay"          Tag="{x:Reference PaneOverlay}"    Click="NavButton_Click"/>
                    <Button x:Name="NavProfile"     Style="{StaticResource HubNavItem}" Content="Профіль"          Tag="{x:Reference PaneProfile}"    Click="NavButton_Click"/>
                    <Button x:Name="NavAbout"       Style="{StaticResource HubNavItem}" Content="Про програму"     Tag="{x:Reference PaneAbout}"      Click="NavButton_Click"/>
                </StackPanel>
            </Border>

            <!-- Хост панелей категорій -->
            <Grid Grid.Column="2">
                <hub:GeneralSettingsPane x:Name="PaneGeneral" Visibility="Visible"/>

                <hub:SettingsPlaceholderPane x:Name="PaneLocalization" Visibility="Collapsed" Title="Локалізація"
                    Icon="🌐" Message="Керування перекладами Star Citizen. Зараз доступне на екрані «Локалізація»."/>
                <hub:SettingsPlaceholderPane x:Name="PaneInterface" Visibility="Collapsed" Title="Інтерфейс"
                    Icon="🖼" Message="Тема, мова застосунку та масштаб інтерфейсу з'являться тут пізніше."/>
                <hub:HotkeysSettingsPane x:Name="PaneHotkeys" Visibility="Collapsed"/>
                <hub:OverlaySettingsPane x:Name="PaneOverlay" Visibility="Collapsed"/>
                <hub:SettingsPlaceholderPane x:Name="PaneProfile" Visibility="Collapsed" Title="Профіль"
                    Icon="☁" Message="Синхронізація налаштувань, резервне копіювання та експорт/імпорт з'являться тут пізніше."/>
                <hub:SettingsPlaceholderPane x:Name="PaneAbout" Visibility="Collapsed" Title="Про програму"
                    Icon="ℹ" Message="Версія, ліцензія та посилання з'являться тут пізніше."/>
            </Grid>
        </Grid>

        <!-- ============ FOOTER ============ -->
        <TextBlock Grid.Row="2" Margin="20,4,20,12" FontFamily="Segoe UI" FontSize="11" Foreground="#6A8AA5">
            <Run FontFamily="Segoe UI Semibold" Foreground="#6F8CA8">F1</Run>
            <Run Text=" — відкрити Центр керування, лише якщо активне вікно SCLOC-Verse"/>
        </TextBlock>
    </Grid>
</Canvas>
